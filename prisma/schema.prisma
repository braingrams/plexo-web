generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TemplateKind {
  EMAIL
  LANDING_PAGE
}

enum SubscriptionPlan {
  FREE
  PRO
  ULTRA
}

enum AiTier {
  AUTO
  BASIC
  MEDIUM
  HIGH
}

enum LayoutMode {
  CLASSIC
  MODERN
}

enum CreditTransactionType {
  MONTHLY_GRANT
  TOPUP_PURCHASE
  AI_USAGE
  REFUND
  ADJUSTMENT
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @default("Plexo User")
  image            String?
  email            String           @unique
  passwordHash     String           @default("")
  isConfirmed      Boolean          @default(false)
  // Was @default(ULTRA) pre-Phase-2 (free beta, no billing). Now that plan
  // determines real monthly AI credit allowance, new signups default to FREE.
  subscriptionPlan SubscriptionPlan @default(FREE)
  customDomainLimit Int?
  // Ultra-gated: lets embedded SDK builders publish/AI under this account without a
  // per-account domain limit. Enforcement of the Ultra requirement happens in app code
  // (see lib/subscription.ts resolveManageLandingPagePublishing), not at the DB layer.
  manageLandingPagePublishing Boolean @default(false)
  layoutMode       LayoutMode       @default(MODERN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Billing / credits (Phase 2)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  allowanceBalance     Int       @default(0)
  topupBalance         Int       @default(0)
  allowanceResetAt     DateTime  @default(now())

  apiKeys          ApiKey[]
  templates        Template[]
  accounts         Account[]
  sessions         Session[]
  publishedDomains PublishedDomain[]
  uploadedImages   UploadedImage[]
  creditLedger     CreditLedgerEntry[]
}

model CreditLedgerEntry {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  type          CreditTransactionType
  amount        Int // positive = credit added, negative = credit spent
  balanceAfter  Int
  description   String?
  stripeEventId String?
  metadata      Json?
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeEventId])
}

// Idempotency guard for Stripe webhook deliveries — insert the event id before
// processing; a unique-constraint violation means it's already been handled.
model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  name      String
  hashedKey String
  maskedKey String
  useAi     Boolean   @default(false)
  aiProvider String    @default("openai")
  aiTier    AiTier    @default(AUTO)
  aiApiKey  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Template {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  name         String
  kind         TemplateKind
  designJson   Json
  compiledHtml String       @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedDomains PublishedDomain[]
  pageViews PageView[]

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
}

model PublishedDomain {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  templateId String   @db.Uuid
  domain     String   @unique
  type       String   // "SUBDOMAIN" | "CUSTOM"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templateId])
  @@index([domain])
}

model PageView {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  domain     String?  // tracks which subdomain/custom domain was visited
  ipHash     String?  // sha-256 hash of visitor IP for unique counting
  userAgent  String?  // browser/device information
  createdAt  DateTime @default(now())

  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([createdAt])
}

model UploadedImage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StockCache {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String   // "unsplash" | "pexels" | "pixabay"
  query     String   // search query
  results   Json     // JSON array of cached StockImageResult[]
  createdAt DateTime @default(now())

  @@unique([provider, query])
}
