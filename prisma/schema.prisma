generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TemplateKind {
  EMAIL
  LANDING_PAGE
}

// BUILDER: page assembled from designJson via the visual builder (existing flow).
// RAW_UPLOAD: user-supplied HTML/CSS/JS uploaded as-is (single .html or a .zip site),
// served verbatim with no sanitization — see server/rawUpload.ts for the isolation
// story that makes this safe (dedicated plexopages.io origin, see middleware.ts).
enum TemplateSourceType {
  BUILDER
  RAW_UPLOAD
}

enum SubscriptionPlan {
  FREE
  PRO
  ULTRA
}

enum AiTier {
  AUTO
  BASIC
  MEDIUM
  HIGH
}

enum LayoutMode {
  CLASSIC
  MODERN
}

enum CreditTransactionType {
  MONTHLY_GRANT
  TOPUP_PURCHASE
  AI_USAGE
  REFUND
  ADJUSTMENT
}

// SYSTEM: Plexo's own credit ledger pays (default).
// BYOK: the account's own provider key pays, no credits touched.
// HOST_MANAGED: the embedding host app authorizes + charges its own users for
// every AI action via a webhook (see lib/ai/hostAuthorization.ts) — Plexo never
// touches its own ledger for this key and never knows the host's credit model.
enum AiAccessMode {
  SYSTEM
  BYOK
  HOST_MANAGED
}

enum NotificationType {
  MENTION
  COMMENT_REPLY
  COMMENT_RESOLVED
  INVITE_ACCEPTED
}

// Owned by better-auth's organization() plugin (server/auth.ts, server/accessControl.ts).
// Member.role is a plain string matching one of accessControl.ts's role ids
// ("owner" | "admin" | "editor" | "commenter" | "viewer") — validated at the app layer via
// the plugin's access-control statements, not enforced as a DB enum, since better-auth
// itself treats roles as strings (see roleSchema in its own schema).
model Organization {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  logo              String?
  // White-label accent color (hex, e.g. "#4f46e5") — null falls back to the default Plexo
  // purple everywhere it's read (dashboard chrome, transactional emails, embedded SDK).
  // Gated to Pro/Ultra: see lib/subscription.ts's canWhiteLabel + getOrganizationOwnerPlan.
  brandColor        String?
  // Explicit opt-in for replacing the Plexo name/logo/color with the org's own — being on a
  // Pro/Ultra plan only makes this ELIGIBLE (see canWhiteLabel), it does not turn it on by
  // itself. Defaults false for every org, including ones that already had a logo/brandColor
  // set under the old automatic-on-Pro/Ultra behavior.
  whiteLabelEnabled Boolean  @default(false)
  // Off by default — every site under this org gets its own independent CommerceWallet
  // (templateId set), matching every other Commerce setting's per-site scoping. When true,
  // all of the org's sites instead credit one shared, org-wide CommerceWallet (templateId
  // null) — see that model's own comments and lib/commerce/wallet.ts::resolveCommerceWallet.
  commerceWalletPooled Boolean  @default(false)
  metadata          String?
  createdAt         DateTime @default(now())

  members          Member[]
  invitations      Invitation[]
  templates        Template[]
  apiKeys          ApiKey[]
  publishedDomains PublishedDomain[]
  uploadedImages   UploadedImage[]
  comments         Comment[]
  notifications    Notification[]

  outgoingSiteTransfers SiteTransferRequest[] @relation("SiteTransferFromOrganization")

  // Plexo Commerce
  commerceCategories             CommerceCategory[]
  commerceProducts               CommerceProduct[]
  commerceProductRelations       CommerceProductRelation[]
  commerceDiscountCodes          CommerceDiscountCode[]
  commerceAvailabilityRules      CommerceAvailabilityRule[]
  commerceAvailabilityExceptions CommerceAvailabilityException[]
  commerceCarts                  CommerceCart[]
  commerceOrders                 CommerceOrder[]
  commerceBookings               CommerceBooking[]
  // One row per site now (CommerceSettings.templateId is the unique key), not per org.
  commerceSettings               CommerceSettings[]
  paystackWebhookEvents          PaystackWebhookEvent[]
  commerceProductReviews         CommerceProductReview[]
  commerceWallets                CommerceWallet[]
  commerceWithdrawalRequests     CommerceWithdrawalRequest[]
  commerceStripeAccessRequests   CommerceStripeAccessRequest[]
  commerceDigitalDeliveries      CommerceDigitalDelivery[]
  formSubmissions                FormSubmission[]
  notificationPreferences        NotificationPreferences?

  // One row per site (SiteLayout.templateId is the unique key), same shape as commerceSettings.
  siteLayouts SiteLayout[]
}

model Member {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  role           String
  status         String   @default("pending")
  inviterId      String   @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// Figma-style anchored comments on the PlexoBuilder canvas. anchorNodeId is a
// RowJSON/ColumnJSON/ElementJSON.id from the template's designJson; null means a
// template-level (unanchored) comment. See plexo-sdk's data-plexo-node-id +
// getNodeRect() additions for how the pin's on-screen position is resolved.
model Comment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  templateId     String    @db.Uuid
  authorId       String    @db.Uuid
  parentId       String?   @db.Uuid
  body           String    @db.Text
  anchorNodeId   String?
  anchorNodeType String?
  anchorX        Float?
  anchorY        Float?
  deviceView     String?
  resolvedAt     DateTime?
  resolvedById   String?   @db.Uuid
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  author       User             @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolvedBy   User?            @relation("CommentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent       Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]        @relation("CommentReplies")
  mentions     CommentMention[]

  @@index([templateId])
  @@index([organizationId])
  @@index([parentId])
}

model CommentMention {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

// Backs both the in-app notification bell and the trigger for mention/reply emails
// (see lib/mail/templates.ts's buildMentionEmail/buildCommentReplyEmail).
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  actorId        String?          @db.Uuid
  commentId      String?          @db.Uuid
  templateId     String?          @db.Uuid
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([organizationId])
}

// Owned by plexo-admin (a separate app, same database) — see plexo-admin/prisma/schema.prisma
// for the copy it builds against and plexo-admin/README.md for the two-repo schema-sync
// process. null on User.adminRole = ordinary customer; non-null = staff member permitted
// into the admin app.
enum AdminRole {
  SUPERADMIN
  SUPPORT
  MODERATOR
  FINANCE
}

model User {
  id                          String            @id @default(uuid()) @db.Uuid
  name                        String            @default("Plexo User")
  image                       String?
  email                       String            @unique
  passwordHash                String            @default("")
  isConfirmed                 Boolean           @default(false)
  // Was @default(ULTRA) pre-Phase-2 (free beta, no billing). Now that plan
  // determines real monthly AI credit allowance, new signups default to FREE.
  subscriptionPlan            SubscriptionPlan  @default(FREE)
  // Set at signup when the user picks Pro/Ultra on the pricing page, before they've paid —
  // durably records intent across the signup -> verify-email -> first-login gap (which can
  // span devices/time) since no session exists yet at signup time to persist this any other
  // way (see server/auth.ts's databaseHooks). Cleared once the Stripe webhook confirms payment
  // (or the user explicitly opts to continue on Free) — see app/dashboard/page.tsx's gate and
  // app/auth/complete-subscription.
  pendingPlan                 SubscriptionPlan?
  customDomainLimit           Int?
  // Timestamp of accepting the Acceptable Use Policy — required before a user's first
  // unsanitized raw-HTML publish (see app/api/v1/templates/upload-raw/route.ts).
  aupAcceptedAt               DateTime?
  // Ultra-gated: lets embedded SDK builders publish/AI under this account without a
  // per-account domain limit. Enforcement of the Ultra requirement happens in app code
  // (see lib/subscription.ts resolveManageLandingPagePublishing), not at the DB layer.
  manageLandingPagePublishing Boolean           @default(false)
  // Pro/Ultra-gated: hides the "Hosted with Plexo" bar injected into BUILDER pages served on
  // the shared plexopages.io subdomain (see app/pub/[domain]/[[...slug]]/route.ts). Collapsed
  // with plan entitlement via lib/subscription.ts's resolveHideBranding, same pattern as
  // resolveManageLandingPagePublishing, so a stale true after a downgrade doesn't leak through.
  hideBranding                Boolean           @default(false)
  layoutMode                  LayoutMode        @default(MODERN)
  // Strata design-system project the user has connected — lets AI tooling (MCP) auto-detect
  // and fetch brand tokens without the user re-supplying a project id on every call.
  strataProjectId             String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  // Billing / credits (Phase 2)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  allowanceBalance     Int      @default(0)
  topupBalance         Int      @default(0)
  allowanceResetAt     DateTime @default(now())

  // Marketplace seller earnings (real money, cents) — distinct from the AI-credit
  // balances above. Reserved (debited) the moment a withdrawal is requested, not when
  // it's processed, so a seller can't request more than their available balance across
  // several pending requests at once. See lib/marketplaceListing.ts / SellerLedgerEntry.
  sellerBalanceCents Int @default(0)

  // Owned by plexo-admin: null = ordinary customer, non-null = staff member. See the
  // AdminRole enum's comment above.
  adminRole AdminRole?

  // Owned by plexo-admin: account-wide suspend/reinstate, distinct from a single
  // PublishedDomain's own active/suspendedAt. NOTE: this repo (plexo-web) does not yet
  // check suspendedAt anywhere (sign-in, resolveUser, /pub serving) — setting it from
  // the admin app currently records intent/audit only. A follow-up here should check it
  // in server/auth.ts's sign-in hook and in app/api/v1/**'s resolveUser() before this is
  // a real enforcement mechanism.
  suspendedAt     DateTime?
  suspendedReason String?

  apiKeys          ApiKey[]
  templates        Template[]
  accounts         Account[]
  sessions         Session[]
  publishedDomains PublishedDomain[]
  uploadedImages   UploadedImage[]
  creditLedger     CreditLedgerEntry[]
  adminAuditLogs   AdminAuditLog[]

  outgoingSiteTransfers SiteTransferRequest[] @relation("SiteTransferFromUser")

  memberships            Member[]
  sentInvitations        Invitation[]
  comments               Comment[]             @relation("CommentAuthor")
  resolvedComments       Comment[]             @relation("CommentResolvedBy")
  commentMentions        CommentMention[]
  notifications          Notification[]        @relation("NotificationRecipient")
  triggeredNotifications Notification[]        @relation("NotificationActor")
  templatePurchases      TemplatePurchase[]
  sellerLedger           SellerLedgerEntry[]
  withdrawalRequests     WithdrawalRequest[]
  scriptAccessRequests   ScriptAccessRequest[]
  feedback               Feedback[]
  blogAuthorProfiles     BlogAuthor[]

  commerceWithdrawalRequests   CommerceWithdrawalRequest[]
  commerceStripeAccessRequests CommerceStripeAccessRequest[]
}

model CreditLedgerEntry {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  type          CreditTransactionType
  amount        Int // positive = credit added, negative = credit spent
  balanceAfter  Int
  description   String?
  stripeEventId String?
  metadata      Json?
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeEventId])
}

// Idempotency guard for Stripe webhook deliveries — insert the event id before
// processing; a unique-constraint violation means it's already been handled.
model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// Singleton row (fixed id "global") for platform-wide toggles configurable from
// plexo-admin. Read by lib/marketplaceListing.ts's submitTemplateForMarketplace to decide
// whether a new user-submitted listing needs admin approval (PENDING_REVIEW, the default)
// or goes live immediately (PUBLISHED) — off by default, matching the moderation-first
// design; an admin can flip it on from a settings toggle.
model PlatformSettings {
  id                             String   @id @default("global")
  autoPublishMarketplaceListings Boolean  @default(false)
  // Basis points (1/100th of a percent) — 2000 = 20.00%. Int, not Float, to avoid
  // floating-point rounding when computing fee/net cents on every sale. Read by the
  // Stripe webhook's creditMarketplaceSeller (lib/marketplaceListing.ts).
  marketplaceFeeBps              Int      @default(2000)
  // Basis points taken from a platform-hosted (PLATFORM_PAYSTACK/PLATFORM_STRIPE) Commerce
  // sale before crediting the seller's CommerceWallet — see creditCommerceWallet
  // (lib/commerce/wallet.ts). Defaults to 0 (pure pass-through): an actual take-rate is a
  // business decision, not an engineering one, and this field makes it tunable from
  // plexo-admin later with no further migration.
  commercePlatformFeeBps         Int      @default(0)
  updatedAt                      DateTime @updatedAt
}

enum SellerLedgerType {
  SALE_CREDIT
  WITHDRAWAL_DEBIT
  WITHDRAWAL_REVERSAL
}

// Ledger of every change to User.sellerBalanceCents — mirrors CreditLedgerEntry's shape
// (see lib/credits/ledger.ts), same purpose: an auditable trail alongside the plain
// running balance. gross/fee are only set on SALE_CREDIT rows (kept for audit — Plexo's
// 20% platform fee is visible per-sale); net is what actually moved the balance on every
// row type.
model SellerLedgerEntry {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  type                SellerLedgerType
  grossAmountCents    Int?
  feeCents            Int?
  netAmountCents      Int
  balanceAfterCents   Int
  templatePurchaseId  String?          @db.Uuid
  withdrawalRequestId String?          @db.Uuid
  description         String?
  createdAt           DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templatePurchaseId])
  @@index([withdrawalRequestId])
}

enum WithdrawalStatus {
  PENDING
  PROCESSED
  REJECTED
}

// Manual bank-transfer payout request — the app only tracks status; an admin actually
// sends the money outside this system. Account number / holder name are encrypted at
// rest via lib/crypto.ts's encryptSecret/decryptSecret (same pattern as ApiKey.aiApiKey);
// bank name is left plain since it isn't independently sensitive.
model WithdrawalRequest {
  id                         String           @id @default(uuid()) @db.Uuid
  userId                     String           @db.Uuid
  amountCents                Int
  encryptedAccountNumber     String
  encryptedAccountHolderName String
  bankName                   String
  status                     WithdrawalStatus @default(PENDING)
  // Required at the app layer when status is set to REJECTED — not a DB constraint.
  rejectionReason            String?
  requestedAt                DateTime         @default(now())
  processedAt                DateTime?
  processedByAdminId         String?          @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum ScriptAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A request to run a RAW_UPLOAD template's uploaded JavaScript live inside the Text
// Content tab's preview iframe — normally sandboxed (allow-same-origin, no allow-scripts)
// for safety, see RawTextContentEditor.tsx. Requires Charisol staff approval since granting
// it means switching that iframe to allow-scripts (opaque origin) for a bounded window.
// "Expired" is intentionally NOT a stored status: a request is active iff
// status == APPROVED && expiresAt > now(), checked at read time — same pattern as
// Invitation.expiresAt. No cron job needed.
model ScriptAccessRequest {
  id                 String                    @id @default(uuid()) @db.Uuid
  templateId         String                    @db.Uuid
  userId             String                    @db.Uuid
  // Optional short reason the requester gave — shown to the reviewing admin.
  reason             String?
  status             ScriptAccessRequestStatus @default(PENDING)
  requestedAt        DateTime                  @default(now())
  processedAt        DateTime?
  processedByAdminId String?                   @db.Uuid
  // Staff-entered minutes at approval time — null until approved.
  approvedMinutes    Int?
  // Set at approval = processedAt + approvedMinutes. Null while PENDING/REJECTED.
  expiresAt          DateTime?
  // Required at the app layer when status is set to REJECTED — not a DB constraint.
  rejectionReason    String?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([userId])
  @@index([status])
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  name           String
  hashedKey      String
  maskedKey      String
  useAi          Boolean   @default(false)
  aiProvider     String    @default("openai")
  aiTier         AiTier    @default(AUTO)
  aiApiKey       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  // Host-Managed AI access (Phase 3): lets an embedding host app own AI
  // authorization/billing for its own end users instead of Plexo's ledger.
  // hostAuthWebhookUrl/hostWebhookSecret are only read when aiAccessMode is
  // HOST_MANAGED; hostWebhookSecret is encrypted at rest like aiApiKey and
  // never echoed back to the client (see app/api/settings/api-keys).
  aiAccessMode       AiAccessMode @default(SYSTEM)
  hostAuthWebhookUrl String?
  hostWebhookSecret  String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model Template {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  organizationId String             @db.Uuid
  name           String
  kind           TemplateKind
  // RAW_UPLOAD templates have an empty/placeholder designJson (nothing to edit in the
  // builder) — compiledHtml holds the uploaded index.html verbatim, unsanitized;
  // additional files (css/js/images) live in TemplateAsset.
  sourceType     TemplateSourceType @default(BUILDER)
  designJson     Json
  compiledHtml   String             @db.Text
  // Which @charisol/plexo-sdk version produced the current compiledHtml, and when — lets a
  // bad SDK release's affected rows be identified precisely (`sdkVersion` range + `compiledAt`
  // window) without adding any field to designJson itself, which would be silently stripped by
  // this app's own designJson Zod validator (server/sanitizer.ts) on the very next save. Both
  // nullable: rows written before this column existed simply have no recorded version.
  sdkVersion     String?
  compiledAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Multipage support: a LANDING_PAGE template with parentId == null is a
  // standalone/home page (the thing a PublishedDomain links to, unchanged
  // from pre-multipage behavior). A non-null parentId makes this row a
  // sub-page reachable at <domain>/<slug> under its parent — and since the
  // parent can itself be a sub-page, arbitrary nesting (/blog/post-1) falls
  // out of this self-relation without any extra modeling.
  parentId String? @db.Uuid
  // One path segment (e.g. "post-1"), not the full path. Null for root pages.
  slug     String?
  order    Int     @default(0)

  // Marks this as a genuinely public, platform-curated template — distinct from userId, which
  // is just whoever owns the row. Only flippable via the email-allowlisted admin route (see
  // app/api/admin/templates/[id]/official/route.ts); /api/v1/public-templates queries this
  // platform-wide, unscoped by owner, which is the whole point of it being "public."
  isOfficial Boolean @default(false)

  // Template marketplace: owned by plexo-admin (curation) and served here by
  // app/marketplace (browse/filter) + app/api/v1/marketplace/** (list/purchase/use).
  // null marketplaceStatus = an ordinary, non-marketplace Template (nearly all rows).
  // "type" filter on the public page is TemplateKind (kind, above); marketplaceCategory
  // is a free-text tag plexo-admin sets, no separate taxonomy table.
  marketplaceStatus          MarketplaceStatus?
  marketplaceCategory        String?
  marketplaceDescription     String?
  // Cents; 0 or null = free. Int, not Float, to avoid floating-point cent errors.
  priceCents                 Int?
  marketplacePublishedAt     DateTime?
  // Optional note an admin may leave when rejecting a user-submitted listing (PENDING_REVIEW
  // -> REJECTED). Not required, unlike WithdrawalRequest.rejectionReason — admin-curated
  // listings never use this at all.
  marketplaceRejectionReason String?

  // A LANDING_PAGE Template a site owner designed as a custom blog layout (via the
  // builder's isBlogLayout-gated "Blog" block palette) rather than an ordinary page —
  // referenced by BlogSite.postLayoutTemplateId/listingLayoutTemplateId, never itself
  // published/visited directly. Excluded from the normal dashboard template list/count
  // and from maxLandingPages plan-limit counting (see app/api/templates/route.ts) so it
  // doesn't silently consume a customer's page slot or show up as a stray untitled page.
  isBlogLayout Boolean @default(false)

  // A small ordinary LANDING_PAGE Template used as a site's shared header or footer (see
  // SiteLayout below) rather than a page in its own right — same "never itself
  // published/visited directly, excluded from the normal page list/count" shape as
  // isBlogLayout, just for SiteLayout.headerTemplateId/footerTemplateId instead of
  // BlogSite.postLayoutTemplateId/listingLayoutTemplateId.
  isSiteLayoutFragment Boolean @default(false)

  // A LANDING_PAGE Template used as a site's single reusable product-detail layout (see
  // CommerceSettings.productDetailTemplateId) rather than a page in its own right — same
  // "never itself published/visited directly, excluded from the normal page list/count
  // and plan-limit counting" shape as isBlogLayout/isSiteLayoutFragment.
  isCommerceLayout Boolean @default(false)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent               Template?             @relation("TemplatePages", fields: [parentId], references: [id], onDelete: Cascade)
  pages                Template[]            @relation("TemplatePages")
  publishedDomains     PublishedDomain[]
  pageViews            PageView[]
  assets               TemplateAsset[]
  comments             Comment[]
  purchases            TemplatePurchase[]
  scriptAccessRequests ScriptAccessRequest[]

  // Blog (see the Blog* models below) — always scoped to the site's ROOT Template
  // (parentId == null), the same row PublishedDomain already points at.
  blogSite                 BlogSite?
  blogAuthors              BlogAuthor[]
  blogCategories           BlogCategory[]
  blogTags                 BlogTag[]
  blogPosts                BlogPost[]
  blogRedirects            BlogRedirect[]
  importJobs               ImportJob[]
  importMediaMaps          ImportMediaMap[]
  siteImportJobs           SiteImportJob[]
  revisions                TemplateRevision[]
  // Reverse side of BlogSite's two named 1:1 layout-template relations — see BlogSite.
  blogSitePostLayoutFor    BlogSite?          @relation("BlogSitePostLayout")
  blogSiteListingLayoutFor BlogSite?          @relation("BlogSiteListingLayout")

  // Shared header/footer applied to every ordinary page on this site — see SiteLayout.
  // Always scoped to the site's ROOT Template (parentId == null).
  siteLayout          SiteLayout? @relation("SiteLayoutSite")
  // Reverse side of SiteLayout's two named 1:1 layout-template relations, mirroring
  // blogSitePostLayoutFor/blogSiteListingLayoutFor above.
  siteLayoutHeaderFor SiteLayout? @relation("SiteLayoutHeader")
  siteLayoutFooterFor SiteLayout? @relation("SiteLayoutFooter")

  // Reverse side of CommerceSettings.productDetailTemplateId — see CommerceSettings.
  commerceProductDetailLayoutFor CommerceSettings? @relation("CommerceProductDetailLayout")

  siteTransferRequests SiteTransferRequest[]

  // Plexo Commerce — scoped per SITE (this root Template), not per organization, same
  // reasoning as Blog: an org can own multiple sites, each needing its own catalog and
  // its own Paystack keys. Always scoped to the site's ROOT Template (parentId == null).
  commerceSettings               CommerceSettings?
  commerceCategories             CommerceCategory[]
  commerceProducts               CommerceProduct[]
  commerceProductRelations       CommerceProductRelation[]
  commerceDiscountCodes          CommerceDiscountCode[]
  commerceAvailabilityRules      CommerceAvailabilityRule[]
  commerceAvailabilityExceptions CommerceAvailabilityException[]
  commerceCarts                  CommerceCart[]
  commerceOrders                 CommerceOrder[]
  commerceBookings               CommerceBooking[]
  paystackWebhookEvents          PaystackWebhookEvent[]
  commerceProductReviews         CommerceProductReview[]
  formSubmissions                FormSubmission[]
  commerceDigitalDeliveries      CommerceDigitalDelivery[]
  // The site's own wallet (CommerceWallet.templateId) — null on a site whose org has
  // commerceWalletPooled enabled, since its sales credit the org's pooled wallet instead.
  commerceWallet                 CommerceWallet?

  @@unique([parentId, slug])
  @@index([userId])
  @@index([organizationId])
  @@index([parentId])
  @@index([marketplaceStatus])
}

// Point-in-time snapshot of a Template's designJson/compiledHtml, written on every real
// (dirty-gated) save. Exists so a bad @charisol/plexo-sdk release can be rolled back per
// template — restore a row's prior bytes directly — without ever needing to bulk-recompile
// every stored compiledHtml, which would risk changing already-published pages that no one
// asked to change. Retention-limited (see the cleanup job referenced wherever this is written)
// rather than kept forever, since this is a rollback safety net, not an audit trail.
model TemplateRevision {
  id           String   @id @default(uuid()) @db.Uuid
  templateId   String   @db.Uuid
  designJson   Json
  compiledHtml String   @db.Text
  sdkVersion   String
  createdAt    DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
}

enum MarketplaceStatus {
  DRAFT
  // User-submitted listing awaiting admin review — see PlatformSettings.
  // autoPublishMarketplaceListings for the opt-out.
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum TemplateGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

// Tracks one admin-triggered "Generate Templates with AI" batch (plexo-admin). Processed
// incrementally in chunks (see plexo-admin's lib/generation/job.ts) rather than in one
// long-running request, so progress survives a serverless invocation timeout — lockedAt
// is a heartbeat preventing the cron tick and a manual "process now" click from double-
// processing the same job concurrently.
model TemplateGenerationJob {
  id                 String                   @id @default(uuid()) @db.Uuid
  status             TemplateGenerationStatus @default(PENDING)
  kind               TemplateKind
  isOptIn            Boolean                  @default(false)
  category           String
  priceCents         Int                      @default(0)
  targetStatus       MarketplaceStatus
  provider           String // "anthropic_claude" | "openai" | "google_gemini"
  requestedCount     Int
  succeededCount     Int                      @default(0)
  failedCount        Int                      @default(0)
  createdTemplateIds String[]                 @default([])
  errors             Json?
  lockedAt           DateTime?
  createdBy          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([status])
}

// One row per user who has unlocked a marketplace template (paid or claimed-free) — the
// gate app/api/v1/marketplace/templates/[id]/use checks before letting someone duplicate
// a marketplace template into their own account. Free templates still get a row
// (priceCentsPaid 0) so "already own this"/"my library" checks don't special-case free.
model TemplatePurchase {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  templateId      String   @db.Uuid
  priceCentsPaid  Int
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
}

// Non-root files belonging to a RAW_UPLOAD template (style.css, app.js, images, fonts...).
// The root document itself stays in Template.compiledHtml so the common case (single
// self-contained .html upload) needs no blob storage at all.
model TemplateAsset {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  path        String // relative path as referenced in the HTML, e.g. "style.css", "assets/logo.png"
  blobUrl     String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, path])
  @@index([templateId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Required by better-auth's organization() plugin (server/auth.ts) — tracks which
  // org a multi-membership user is currently "in", set via auth.api.setActiveOrganization
  // (see server/org.ts's ensureActiveOrganization). Plain string, not a Prisma relation,
  // matching Member.role's same "better-auth owns the semantics" convention.
  activeOrganizationId String? @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
}

// better-auth's own rate-limit storage (server/auth.ts rateLimit.storage: "database") —
// required so rate limiting is actually shared across serverless instances instead of
// each one keeping its own in-memory counter (the framework default), which would let
// an attacker bypass limits simply by landing on a different warm instance.
// lastRequest MUST be BigInt, not Int: it stores Date.now() (epoch milliseconds), which
// overflows a 32-bit Int. Confirmed against better-auth's own adapter code, which
// explicitly normalizes a bigint lastRequest value read back from the DB.
model RateLimit {
  id          String @id @default(cuid())
  key         String
  count       Int
  lastRequest BigInt

  @@index([key])
}

model PublishedDomain {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  templateId     String   @db.Uuid
  domain         String   @unique
  type           String // "SUBDOMAIN" | "CUSTOM"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Persisted DNS verification (previously only lived in transient client state, so a
  // page reload always reverted CUSTOM domains to "Check DNS" even after a successful check).
  dnsVerified   Boolean   @default(false)
  dnsVerifiedAt DateTime?

  // Takedown / abuse-scan state (see lib/safeBrowsing.ts, app/api/internal/domains/[id]/suspend).
  // /pub refuses to serve content for a domain with active=false.
  active          Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  flagged         Boolean   @default(false)
  flagReason      String?
  lastScannedAt   DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([templateId])
  @@index([domain])
}

model PageView {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  domain     String? // tracks which subdomain/custom domain was visited
  ipHash     String? // sha-256 hash of visitor IP for unique counting — raw IP is never stored
  userAgent  String? // browser/device information
  // Derived from Vercel's geolocation headers (free, no third-party API) — coarse
  // country/region/city only, never the raw IP that produced them.
  country    String?
  region     String?
  city       String?
  // Parsed from userAgent at write time so the dashboard can filter/display without
  // re-parsing the raw string per row.
  deviceType String? // "mobile" | "tablet" | "desktop"
  browser    String?
  os         String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([createdAt])
}

model UploadedImage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  name           String
  url            String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model StockCache {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String // "unsplash" | "pexels" | "pixabay"
  query     String // search query
  results   Json // JSON array of cached StockImageResult[]
  createdAt DateTime @default(now())

  @@unique([provider, query])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id        String            @id @default(uuid()) @db.Uuid
  quote     String
  name      String
  role      String
  company   String?
  avatarUrl String?
  rating    Int               @default(5)
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ARCHIVED
}

// User-submitted product feedback — see app/dashboard/_components/FeedbackButton.tsx
// (plexo-web) and app/(dashboard)/feedback (plexo-admin's triage queue).
model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  // Denormalized snapshot at submission time so feedback stays attributable/readable in
  // the admin even if the account is later renamed or deleted — userId is SetNull, not
  // Cascade, for the same reason: the feedback itself is still worth keeping.
  userEmail String
  userName  String
  message   String         @db.Text
  pageUrl   String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

// Owned by plexo-admin entirely: one row per mutating admin action, written by
// plexo-admin/server/audit.ts's writeAuditLog(). Never mutated or deleted after creation.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String   @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================================
// Blog
// ============================================================================
// A "site" is a root Template (parentId == null) — the same row PublishedDomain
// points at. Every Blog* model below is scoped by templateId to that root, matching
// the convention PublishedDomain already uses. The public path is fixed at
// "<domain>/blog" (not stored anywhere) so it can be served by literal Next.js route
// segments (app/pub/[domain]/blog/**) that always take routing precedence over the
// sibling [[...slug]] catch-all — see that route's own comments for why.

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogSite {
  id                String  @id @default(uuid()) @db.Uuid
  templateId        String  @unique @db.Uuid
  enabled           Boolean @default(false)
  title             String  @default("Blog")
  description       String?
  postsPerPage      Int     @default(10)
  defaultCategoryId String? @db.Uuid
  // WordPress's "Reading Settings: your homepage displays" toggle — when true, the
  // site's root path ("/") serves the blog listing instead of the builder's own
  // root page. Enforced in app/pub/[domain]/[[...slug]]/route.ts.
  showOnHomepage    Boolean @default(false)

  // Basic appearance — enough to approximate a migrated site's old brand without
  // reimplementing an arbitrary WordPress theme (not portable: it's PHP templates +
  // theme-specific CSS running on WordPress's own engine). accentColor is validated as a
  // strict hex string before ever being interpolated into CSS (see lib/pub/blogTheme.tsx's
  // sanitizeHexColor) — never trust it as pre-sanitized just because it's in the DB.
  // fontPreset is a closed set of keys (lib/pub/blogTheme.tsx's FONT_STACKS) mapped
  // server-side to a fixed CSS font-stack, never a raw user-supplied font-family string.
  accentColor    String?
  fontPreset     String  @default("sans")
  logoUrl        String?
  headerImageUrl String?

  // Custom drag-and-drop layouts (see Template.isBlogLayout above and
  // lib/pub/blogLayoutRender.ts). Null = use the default built-in theme
  // (lib/pub/blogTheme.tsx) — always a safe fallback, nothing breaks by leaving these
  // unset. @unique because a layout Template belongs to at most one site.
  postLayoutTemplateId    String?   @unique @db.Uuid
  postLayoutTemplate      Template? @relation("BlogSitePostLayout", fields: [postLayoutTemplateId], references: [id], onDelete: SetNull)
  listingLayoutTemplateId String?   @unique @db.Uuid
  listingLayoutTemplate   Template? @relation("BlogSiteListingLayout", fields: [listingLayoutTemplateId], references: [id], onDelete: SetNull)

  // Sitewide master switch — BlogPost.commentsEnabled is a per-post override underneath
  // this (both must be true for comments to actually show/accept submissions on a post).
  commentsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// Shared header/footer applied to every ordinary page on a site — authored once in the
// builder as two small row documents, spliced around each page's own designJson at
// compile time (see lib/siteLayout.ts). Same layered-gate shape as BlogSite.enabled /
// CommerceSettings.enabled — disabled (the default) costs nothing, every page compiles
// exactly as it did before this model existed. Always scoped to the site's ROOT Template
// (parentId == null), never a sub-page.
model SiteLayout {
  id             String  @id @default(uuid()) @db.Uuid
  templateId     String  @unique @db.Uuid
  organizationId String  @db.Uuid
  enabled        Boolean @default(false)

  // Each points at an ordinary Template (isSiteLayoutFragment: true) designed in the same
  // builder as any other page — null = nothing authored yet on that side; an enabled
  // SiteLayout with a null header (or footer) simply contributes nothing there. Same
  // "separate reusable Template, referenced by id" shape as
  // BlogSite.postLayoutTemplateId/listingLayoutTemplateId.
  headerTemplateId String?   @unique @db.Uuid
  headerTemplate   Template? @relation("SiteLayoutHeader", fields: [headerTemplateId], references: [id], onDelete: SetNull)
  footerTemplateId String?   @unique @db.Uuid
  footerTemplate   Template? @relation("SiteLayoutFooter", fields: [footerTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template     Template     @relation("SiteLayoutSite", fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum SiteTransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

// User-initiated site ownership transfer — the Supabase "transfer project" model: the
// current owner names a recipient by email, the recipient (who may not have a Plexo
// account yet) reviews the SAME plan-compatibility warnings fresh at accept time and
// explicitly accepts before anything moves. Distinct from Invitation (better-auth's
// built-in "join my org as a member" flow) — this moves the SITE ITSELF to a different
// organization entirely, not membership in this one. See server/siteTransfer.ts for the
// full reassignment (every organizationId-scoped row belonging to this site's template
// tree, not just the Template row) and compatibility-check logic.
model SiteTransferRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  templateId            String             @db.Uuid // the root site being transferred
  fromOrganizationId    String             @db.Uuid
  fromUserId            String             @db.Uuid
  toEmail               String // lowercased at write time
  toUserId              String?            @db.Uuid // resolved once accepted (or once a matching account is found)
  status                SiteTransferStatus @default(PENDING)
  token                 String             @unique // accept-link token; the recipient may not be signed in yet
  // Snapshot of the warnings shown to the SENDER at initiation — kept for reference, not
  // trusted at accept time (the recipient's own accept-time check is authoritative, since
  // plans/usage can change between initiation and response).
  compatibilityWarnings Json?
  createdAt             DateTime           @default(now())
  respondedAt           DateTime?
  expiresAt             DateTime

  template         Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fromOrganization Organization @relation("SiteTransferFromOrganization", fields: [fromOrganizationId], references: [id], onDelete: Cascade)
  fromUser         User         @relation("SiteTransferFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([toEmail])
  @@index([status])
  @@index([fromOrganizationId])
}

// A byline, not an account — may or may not be linked to a real Plexo User. WordPress
// lets you attribute posts to an author who never logs in; imported posts in particular
// almost always need this (the WP author rarely maps to a Plexo account).
model BlogAuthor {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  userId     String?  @db.Uuid
  name       String
  slug       String
  avatarUrl  String?
  bio        String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts    BlogPost[]

  @@unique([templateId, slug])
  @@index([templateId])
  @@index([userId])
}

model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  name        String
  slug        String
  description String?
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  template Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent   BlogCategory?      @relation("BlogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children BlogCategory[]     @relation("BlogCategoryTree")
  posts    BlogPostCategory[]

  @@unique([templateId, slug])
  @@index([templateId])
  @@index([parentId])
}

model BlogTag {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  name       String
  slug       String
  createdAt  DateTime @default(now())

  template Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  posts    BlogPostTag[]

  @@unique([templateId, slug])
  @@index([templateId])
}

model BlogPost {
  id                 String         @id @default(uuid()) @db.Uuid
  templateId         String         @db.Uuid
  authorId           String?        @db.Uuid
  title              String
  slug               String
  excerpt            String?        @db.Text
  // Tiptap/ProseMirror JSON — the source of truth the editor round-trips.
  contentJson        Json
  // Rendered + sanitized (sanitize-html) HTML cache served to visitors — mirrors
  // Template.compiledHtml's existing "precompute once, serve cheaply" pattern. MUST be
  // re-sanitized on every write (editor save AND WordPress import): unlike RAW_UPLOAD's
  // compiledHtml, this renders on the tenant's real live domain, not an isolated origin.
  contentHtml        String         @db.Text
  featuredImageUrl   String?
  featuredImageAlt   String?
  status             BlogPostStatus @default(DRAFT)
  publishedAt        DateTime?
  scheduledAt        DateTime?
  metaTitle          String?
  metaDescription    String?
  ogImageUrl         String?
  noindex            Boolean        @default(false)
  readingTimeMinutes Int?
  viewCount          Int            @default(0)
  // Set only by the WordPress importer (the WP numeric post ID). Combined with the
  // @@unique below, makes every import batch an upsert — safe to retry/resume a batch
  // without duplicating posts. Null for posts authored directly in Plexo.
  externalId         String?
  // Per-post override underneath BlogSite.commentsEnabled's sitewide master switch.
  commentsEnabled    Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  template   Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  author     BlogAuthor?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories BlogPostCategory[]
  tags       BlogPostTag[]
  comments   BlogComment[]

  @@unique([templateId, slug])
  @@unique([templateId, externalId])
  @@index([templateId, status, publishedAt])
  @@index([authorId])
}

model BlogPostCategory {
  postId     String @db.Uuid
  categoryId String @db.Uuid

  post     BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model BlogPostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

enum BlogCommentStatus {
  PENDING
  APPROVED
  SPAM
  REJECTED
}

// Public, no-login comment submission — the most adversarial input surface in this app
// (fully anonymous, unlike post content which always comes from the site owner or the WP
// importer). Every comment starts PENDING (or auto-SPAM via a crude heuristic — see
// app/api/blog-comments/route.ts) and is never publicly visible until a site owner
// approves it from the dashboard; body is plain-text-sanitized (lib/blog/sanitizeComment.ts),
// no HTML allowlist at all unlike sanitizeBlogHtml.
model BlogComment {
  id          String            @id @default(uuid()) @db.Uuid
  postId      String            @db.Uuid
  parentId    String?           @db.Uuid
  authorName  String
  // Never shown publicly — moderation contact only.
  authorEmail String
  body        String            @db.Text
  status      BlogCommentStatus @default(PENDING)
  // sha256, same pattern as PageView.ipHash (server/analytics.ts) — raw IP never stored.
  // Powers the submission endpoint's "N comments per IP per hour" throttle.
  ipHash      String?
  createdAt   DateTime          @default(now())

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("BlogCommentReplies")

  @@index([postId, status])
  @@index([ipHash, createdAt])
}

// Old-URL -> new-post 301s. Auto-populated by the WordPress importer (one row per
// historical permalink the REST API reports, plus the WP "shortlink" form /?p={id})
// so inbound Google/backlink equity survives the migration. Also usable for an
// in-Plexo slug rename, so that doesn't silently 404 old links either.
model BlogRedirect {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  fromPath   String
  toPath     String
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fromPath])
  @@index([templateId])
}

enum ImportSourceType {
  WP_REST
  WXR_UPLOAD
}

enum ImportJobStatus {
  PENDING
  DISCOVERING
  RUNNING
  PAUSED_ERROR
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportMediaHandling {
  RETAIN
  REHOST
}

// One row per WordPress-migration attempt. Processed incrementally in bounded batches
// (each invocation does one batch, then self-re-triggers via Next's after() — see
// lib/blogImport/**) rather than one long-running request, so progress survives a
// serverless invocation timeout. lastHeartbeatAt is the same stalled-job guard idea as
// TemplateGenerationJob.lockedAt above (owned by plexo-admin) — a cron sweep uses it to
// detect and resume a batch chain that died mid-flight without double-processing a
// still-live one. `processing` is an explicit claim lock (set true for the duration of a
// batch, cleared after) so an overlapping invocation of the same job — e.g. the stalled-job
// cron firing while a batch is still genuinely in flight — bails out instead of racing the
// live one on the same cursor/media uploads.
model ImportJob {
  id              String              @id @default(uuid()) @db.Uuid
  templateId      String              @db.Uuid
  sourceType      ImportSourceType
  sourceUrl       String?
  wxrBlobUrl      String?
  status          ImportJobStatus     @default(PENDING)
  mediaHandling   ImportMediaHandling @default(RETAIN)
  processing      Boolean             @default(false)
  cursor          Json?
  totalPosts      Int?
  processedPosts  Int                 @default(0)
  totalMedia      Int?
  processedMedia  Int                 @default(0)
  errors          Json?
  lastHeartbeatAt DateTime?
  createdBy       String?             @db.Uuid
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([status])
}

// Dedupes re-hosted WordPress media across retried/resumed import batches, keyed by the
// OLD media URL, so a rerun never re-downloads/re-uploads the same file twice.
model ImportMediaMap {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  sourceUrl  String
  blobUrl    String
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sourceUrl])
  @@index([templateId])
}

enum SiteImportPlatform {
  WORDPRESS
  SQUARESPACE
  WIX
  WEBFLOW
  UNKNOWN // detection failed, or user picked "generic HTML site"
}

enum SiteImportPhase {
  PENDING
  DETECTING
  DISCOVERING
  FETCHING
  REWRITING
  COMPLETED
  PAUSED_ERROR
  FAILED
  CANCELLED
}

enum SiteImportPageOutcome {
  PENDING
  PAGE_CREATED // became a Template
  POST_CREATED // became a BlogPost
  SKIPPED_DUPLICATE
  FAILED
  EXCLUDED // discovered but out of scope (page cap, robots.txt disallow)
}

// One row per "import a website" attempt — the whole-site analogue of ImportJob, covering
// both the raw-page clone and (optionally) the structured blog-post import in one job, since
// discovery/fetch/asset/link-rewrite machinery is identical for both outputs; only the final
// write target (Template vs BlogPost) differs per discovered page. Deliberately a SEPARATE
// model from ImportJob, not an extension of it: ImportJob's cursor/fields are wp-rest/wxr
// post-batch shaped end to end, with no notion of "page" output or a DETECT->REWRITE phase
// machine. WordPress-blog-only import keeps using ImportJob, unmodified, as its own simpler
// path off the Blog Details screen.
model SiteImportJob {
  id             String @id @default(uuid()) @db.Uuid
  templateId     String @db.Uuid // destination site's ROOT Template (parentId == null)
  organizationId String @db.Uuid // denormalized from Template for cheap org-scoped rate-limit queries
  sourceUrl      String // normalized homepage URL of the site being cloned

  platform        SiteImportPlatform  @default(UNKNOWN)
  importBlogPosts Boolean             @default(false)
  mediaHandling   ImportMediaHandling @default(REHOST) // REHOST default: see assetInternalize.ts doc comment
  phase           SiteImportPhase     @default(PENDING)
  processing      Boolean             @default(false)
  lastHeartbeatAt DateTime?

  // Per-import attestation (distinct from the account-level raw-upload AUP acceptance — this
  // is about authorization for THIS specific external domain). Required before FETCHING.
  ownershipAttestedAt DateTime?
  ownershipAttestedBy String?   @db.Uuid

  urlMap Json? // Record<normalizedSourceUrl, newPlexoPath>, built during FETCHING, consumed by REWRITING

  totalPages      Int?
  processedPages  Int  @default(0)
  totalAssets     Int?
  processedAssets Int  @default(0)

  errors   Json? // string[], same convention as ImportJob.errors
  warnings Json? // string[] surfaced in the final report

  createdBy  String?   @db.Uuid
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  template   Template              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pages      SiteImportPage[]
  assetBlobs SiteImportAssetBlob[]

  @@index([templateId])
  @@index([organizationId])
  @@index([phase])
}

// One row per URL discovered during DISCOVERING — the unit of work FETCHING iterates over
// (claim query: WHERE jobId = ? AND outcome = 'PENDING'), and the durable per-page record
// backing the final report and REWRITING's link-target lookups.
model SiteImportPage {
  id        String @id @default(uuid()) @db.Uuid
  jobId     String @db.Uuid
  sourceUrl String

  isBlogPost              Boolean               @default(false) // classification result from DISCOVERING
  outcome                 SiteImportPageOutcome @default(PENDING)
  createdTemplateId       String?               @db.Uuid // set when outcome = PAGE_CREATED
  createdBlogPostId       String?               @db.Uuid // set when outcome = POST_CREATED
  usedHeadless            Boolean               @default(false)
  heuristicExtraction     Boolean               @default(false) // Readability-extracted, not platform-API-sourced
  interactiveFeatureFlags Json? // string[], e.g. ["wix-form","wix-search"]
  rewrittenAt             DateTime? // set once REWRITING has processed this row
  error                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job SiteImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourceUrl])
  @@index([jobId, outcome])
}

// Content-addressed cache for crawled assets, scoped to one job. Lets many pages within the
// same imported site that reference identical bytes (a shared theme stylesheet, a logo) share
// one physical Blob upload instead of re-uploading per page — see assetInternalize.ts. Does
// not touch TemplateAsset's own (templateId, path) semantics at all; this only decides what
// blobUrl a TemplateAsset row points at.
model SiteImportAssetBlob {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @db.Uuid
  sha256      String // hex digest of the asset's bytes
  blobUrl     String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  job SiteImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sha256])
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────
// Plexo Commerce — products, booking calendar, cart/checkout, Paystack.
// Every org brings its own Paystack keys (CommerceSettings); nothing here is
// scoped to Plexo's own platform account. See the Plexo Commerce plan for the
// full checkout/webhook/availability flow this data model supports.
// ─────────────────────────────────────────────────────────────────────────

model CommerceCategory {
  id             String   @id @default(uuid()) @db.Uuid
  // Primary scope: the site this catalog belongs to (a root Template). organizationId is
  // denormalized alongside it, same rationale as SiteImportJob.organizationId — cheap
  // org-wide queries without joining through Template.
  templateId     String   @db.Uuid
  organizationId String   @db.Uuid
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template     Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     CommerceProduct[]

  @@unique([templateId, slug])
  @@index([templateId])
  @@index([organizationId])
}

enum CommerceProductKind {
  PHYSICAL
  SERVICE
  DIGITAL
}

enum CommerceDigitalDeliveryMethod {
  FILE_DOWNLOAD
  EXTERNAL_LINK
  ACCESS_LIST
}

model CommerceProduct {
  id               String              @id @default(uuid()) @db.Uuid
  // Primary scope: the site this product is sold on (a root Template) — see
  // CommerceCategory's comment. organizationId stays denormalized for cheap org-wide
  // queries (e.g. a future "all products across every site" admin view).
  templateId       String              @db.Uuid
  organizationId   String              @db.Uuid
  categoryId       String?             @db.Uuid
  name             String
  slug             String
  description      String?
  imageUrl         String?
  // Small array of additional image URLs — the detail page's thumbnail strip.
  galleryImageUrls Json?
  kind             CommerceProductKind @default(PHYSICAL)
  priceMinor       Int // kobo
  currency         String              @default("NGN")
  // Physical products only — null means "not tracked" (SERVICE rows always leave this
  // null so a consultation never shows a stock badge). Decremented atomically at
  // checkout under a `stockQuantity >= quantity` guard — see the Commerce plan's
  // "no overselling stock" hardening note.
  stockQuantity    Int?
  // Services only.
  durationMinutes  Int?

  // Digital products only (kind === DIGITAL) — null on PHYSICAL/SERVICE rows, same
  // "only the relevant kind's fields are populated" convention as stockQuantity/
  // durationMinutes above. Exactly one of digitalFileUrl / digitalExternalUrl /
  // digitalAccessInstructions is populated, matching digitalDeliveryMethod.
  digitalDeliveryMethod         CommerceDigitalDeliveryMethod?
  // Private Vercel Blob URL (FILE_DOWNLOAD) — never served directly, only ever resolved
  // to a short-lived signed URL by the token-gated download route.
  digitalFileUrl                String?
  digitalFileName               String?
  digitalFileSizeBytes          Int?
  // EXTERNAL_LINK — a seller-provided Drive/Dropbox/etc. link, routed through our own
  // token rather than emailed raw so a compromised link can be revoked without re-sending.
  digitalExternalUrl            String?
  // ACCESS_LIST — what the buyer is told (a private course URL, an invite process, etc.);
  // the seller manages the actual access grant themselves outside Plexo.
  digitalAccessInstructions     String?
  digitalAccessPasswordEncrypted String?
  // FILE_DOWNLOAD only; null = unlimited / never expires.
  digitalMaxDownloads           Int?
  digitalLinkExpiryDays         Int?

  // Product pages are high commercial-intent — they get their own SEO fields from day
  // one rather than inheriting only a bare <title>, the same gap flagged for ordinary
  // builder pages.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  active      Boolean   @default(true)
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  template     Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     CommerceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems             CommerceOrderItem[]
  cartItems              CommerceCartItem[]
  bookings               CommerceBooking[]
  availabilityRules      CommerceAvailabilityRule[]
  availabilityExceptions CommerceAvailabilityException[]
  reviews                CommerceProductReview[]
  // Two named relations because CommerceProductRelation has two FKs pointing back at
  // this same model (the "from" product and the "related" product it's paired with).
  relatedFrom            CommerceProductRelation[]       @relation("CommerceProductRelationsFrom")
  relatedTo              CommerceProductRelation[]       @relation("CommerceProductRelationsTo")
  digitalDeliveries      CommerceDigitalDelivery[]

  @@unique([templateId, slug])
  @@index([templateId])
  @@index([organizationId])
  @@index([categoryId])
}

// "Frequently bought together" — a short, staff-curated list per product (2-3 rows),
// not a recommendation engine. Simple and correct for a catalog this size.
model CommerceProductRelation {
  id               String   @id @default(uuid()) @db.Uuid
  templateId       String   @db.Uuid
  organizationId   String   @db.Uuid
  productId        String   @db.Uuid
  relatedProductId String   @db.Uuid
  createdAt        DateTime @default(now())

  template       Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        CommerceProduct @relation("CommerceProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct CommerceProduct @relation("CommerceProductRelationsTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([templateId])
  @@index([organizationId])
}

enum CommerceDiscountType {
  PERCENT
  FIXED
}

// Fast-follow feature (see the Commerce plan) — modeled now since it's cheap alongside
// everything else, admin CRUD + checkout-time validation come later.
model CommerceDiscountCode {
  id             String               @id @default(uuid()) @db.Uuid
  templateId     String               @db.Uuid
  organizationId String               @db.Uuid
  code           String
  type           CommerceDiscountType
  value          Int
  active         Boolean              @default(true)
  expiresAt      DateTime?
  usageLimit     Int?
  usedCount      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Unique per site, not globally — two different sites (even under the same org) can
  // both run "WELCOME10".
  @@unique([templateId, code])
  @@index([templateId])
  @@index([organizationId])
}

model CommerceAvailabilityRule {
  id             String   @id @default(uuid()) @db.Uuid
  templateId     String   @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  dayOfWeek      Int // 0 (Sunday) – 6 (Saturday)
  startMinute    Int // minutes from midnight, in `timezone`
  endMinute      Int
  timezone       String   @default("Africa/Lagos")
  createdAt      DateTime @default(now())

  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([organizationId])
  @@index([productId])
}

// One-off closures (holidays etc.) — v1 doesn't need custom-hours overrides, just
// closed/open for a given date.
model CommerceAvailabilityException {
  id             String   @id @default(uuid()) @db.Uuid
  templateId     String   @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  date           DateTime @db.Date
  closed         Boolean  @default(true)
  createdAt      DateTime @default(now())

  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([templateId])
  @@index([organizationId])
}

enum CommerceCartStatus {
  OPEN
  CONVERTED
  ABANDONED
}

// Server-persisted cart, identified by a cartToken in an httpOnly cookie — no customer
// accounts needed. customerEmail is captured as soon as the checkout details step asks
// for it, even before payment — the foundation for abandoned-cart recovery later.
model CommerceCart {
  id             String             @id @default(uuid()) @db.Uuid
  templateId     String             @db.Uuid
  organizationId String             @db.Uuid
  cartToken      String             @unique
  customerEmail  String?
  status         CommerceCartStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  template     Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        CommerceCartItem[]
  order        CommerceOrder?

  @@index([templateId])
  @@index([organizationId])
}

model CommerceCartItem {
  id                     String   @id @default(uuid()) @db.Uuid
  cartId                 String   @db.Uuid
  productId              String   @db.Uuid
  quantity               Int      @default(1)
  unitPriceMinorSnapshot Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  cart    CommerceCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

enum CommerceOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// Deliberately a separate axis from CommerceOrderStatus — a PAID order can still be
// sitting unpacked; payment state and fulfillment state answer different questions.
enum CommerceOrderFulfillmentStatus {
  UNFULFILLED
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
}

enum CommerceDeliveryMethod {
  PICKUP
  COURIER
}

enum CommercePaystackMode {
  TEST
  LIVE
}

// BYO_PAYSTACK (default): the site's own keys, unchanged existing behavior — charges land
// directly in the site owner's own Paystack account, Plexo never touches the money.
// PLATFORM_PAYSTACK / PLATFORM_STRIPE: routed through Plexo's own account instead,
// crediting the site's CommerceWallet (see below) as a withdrawable balance.
// PLATFORM_STRIPE additionally requires an APPROVED CommerceStripeAccessRequest for the
// org before checkout will honor it — enforced at the settings-write layer, not here.
enum CommercePaymentProvider {
  BYO_PAYSTACK
  PLATFORM_PAYSTACK
  PLATFORM_STRIPE
}

model CommerceOrder {
  id             String  @id @default(uuid()) @db.Uuid
  // Primary scope: the site the visitor bought from. organizationId stays denormalized
  // alongside it, for cheap org-scoped queries — same rationale as SiteImportJob.organizationId.
  templateId     String  @db.Uuid
  organizationId String  @db.Uuid
  // Short human-facing code (e.g. "HLX-10482") — what the order-confirmation block and
  // a customer's own order-tracking lookup show. Separate from the internal id.
  orderNumber    String  @unique
  cartId         String? @unique @db.Uuid

  customerEmail String
  customerName  String?
  customerPhone String?

  deliveryMethod      CommerceDeliveryMethod?
  deliveryFeeMinor    Int                     @default(0)
  discountCode        String?
  discountAmountMinor Int                     @default(0)
  amountMinor         Int
  currency            String                  @default("NGN")

  status            CommerceOrderStatus            @default(PENDING)
  fulfillmentStatus CommerceOrderFulfillmentStatus @default(UNFULFILLED)

  // Stamped at creation from CommerceSettings.paymentProvider — same "never let a later
  // settings change retroactively reinterpret an already-placed order" rationale as
  // paystackMode below. Determines which webhook/credentials confirm this specific order.
  paymentProvider CommercePaymentProvider @default(BYO_PAYSTACK)

  // Stamped at creation from the org's CommerceSettings.paystackMode at that moment, so
  // flipping an org from test to live mid-flight can't cross-contaminate confirmation.
  // Paystack-only — null for a PLATFORM_STRIPE order (paystackReference/paystackMode both
  // unused in that case; see stripeCheckoutSessionId/stripePaymentIntentId instead).
  paystackMode             CommercePaystackMode?
  paystackReference        String?              @unique
  paystackAuthorizationUrl String?

  // Platform Stripe only — null for a Paystack order (BYO or platform).
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template     Template                  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cart         CommerceCart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items        CommerceOrderItem[]
  booking      CommerceBooking?
  digitalDeliveries    CommerceDigitalDelivery[]
  walletLedgerEntries  CommerceWalletLedgerEntry[]

  @@index([templateId])
  @@index([organizationId])
  @@index([customerEmail])
}

model CommerceOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  productId      String   @db.Uuid
  nameSnapshot   String
  unitPriceMinor Int
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  order   CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

// One row per (order, product) digital line item — created once, when the order flips to
// PAID (see lib/commerce/digitalDelivery.ts::deliverDigitalProducts). Snapshots the
// deliverable at delivery time (file URL, external link, or access instructions/password)
// so a seller editing or deleting the product afterward never changes what an already-paid
// buyer can reach — same "stamp it, don't re-derive it live" rationale as
// CommerceOrder.paystackMode. token is the download/access URL's only credential; it's
// never regenerated by a resend, so an already-shared link keeps working.
model CommerceDigitalDelivery {
  id             String                        @id @default(uuid()) @db.Uuid
  templateId     String                        @db.Uuid
  organizationId String                        @db.Uuid
  orderId        String                        @db.Uuid
  productId      String                        @db.Uuid
  method         CommerceDigitalDeliveryMethod
  token          String                        @unique

  // Snapshot of the product's digital fields at the moment of delivery.
  fileUrl                String?
  fileName                String?
  externalUrl             String?
  accessInstructions      String?
  accessPasswordEncrypted String?

  // FILE_DOWNLOAD only.
  maxDownloads Int?
  downloadCount Int @default(0)
  expiresAt     DateTime?

  // Set once the buyer email actually sends; resend bumps resendCount/lastResentAt but
  // never touches token.
  deliveredAt   DateTime?
  resendCount   Int       @default(0)
  lastResentAt  DateTime?
  createdAt     DateTime  @default(now())

  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Idempotent delivery — a webhook retry that races deliverDigitalProducts a second time
  // hits this constraint and no-ops instead of re-crediting/re-emailing.
  @@unique([orderId, productId])
  @@index([templateId])
  @@index([organizationId])
  @@index([productId])
}

enum CommerceBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

model CommerceBooking {
  id             String                @id @default(uuid()) @db.Uuid
  templateId     String                @db.Uuid
  organizationId String                @db.Uuid
  orderId        String                @unique @db.Uuid
  productId      String                @db.Uuid
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         CommerceBookingStatus @default(PENDING_PAYMENT)
  // A PENDING_PAYMENT booking older than this doesn't block the slot for anyone else —
  // someone started checkout and never finished. Swept by the expire-stale-holds cron.
  holdExpiresAt  DateTime?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Concurrency-safe: two visitors racing for the same slot can't both get a row here —
  // the DB itself rejects the second insert. See the Commerce plan's hardening note.
  @@unique([productId, scheduledStart])
  @@index([templateId])
  @@index([organizationId])
}

// One row per SITE (root Template), not per organization — an org with several sites can
// run a separate storefront (own Paystack account, own MailDrip group) on each one.
model CommerceSettings {
  id             String @id @default(uuid()) @db.Uuid
  templateId     String @unique @db.Uuid
  organizationId String @db.Uuid

  // Test and live are two genuinely separate credential pairs, stored side by side — not
  // one pair with a mode label slapped on it. paystackMode picks which pair checkout/webhook
  // actually use; switching it is the ONLY thing that should ever move real charges from
  // test to live, never a half-updated single key field.
  paystackTestPublicKey          String?
  paystackTestSecretKeyEncrypted String?
  paystackLivePublicKey          String?
  paystackLiveSecretKeyEncrypted String?
  paystackMode                   CommercePaystackMode @default(TEST)

  // Which account actually processes this site's Commerce payments — see
  // CommercePaymentProvider. Independent of paystackMode/the key fields above: those stay
  // populated and usable even when paymentProvider has been switched away from
  // BYO_PAYSTACK, so switching back later doesn't require re-entering keys.
  paymentProvider CommercePaymentProvider @default(BYO_PAYSTACK)

  // Nullable — Commerce can send receipts through the org's own MailDrip account (this
  // field set) or, until that exists, through Plexo's shared platform MailDrip key; the
  // group to tag is always org-specific regardless of which account sends the mail.
  maildripApiKeyEncrypted   String?
  maildripPaidGroupId       String?
  // Separate from maildripPaidGroupId — a site visitor can subscribe to updates without
  // ever buying anything or booking a consultation, so this needs its own group and its
  // own opt-in surface (a footer signup block, see commerce.js's renderNewsletterSignup)
  // rather than being folded into the post-purchase tagging flow.
  maildripNewsletterGroupId String?

  notificationEmail String?
  // Master switch — gates whether the published page shell injects commerce.js at all,
  // same layered-gate shape as BlogSite.enabled.
  enabled           Boolean @default(false)

  // A single reusable "Product Detail" layout Template (Template.isCommerceLayout: true) —
  // same "one shared layout, real data spliced in by the runtime at view time" shape as
  // BlogSite.postLayoutTemplateId, just for products instead of blog posts. Never itself
  // published/visited directly: app/pub/[domain]/[[...slug]]/route.ts serves ITS
  // compiledHtml whenever a request's last path segment matches a live product's slug
  // with no page of its own, and commerce.js's renderProductDetail reads which product to
  // show off the visited URL (see the marker's mode="detail"), not off anything baked
  // into this Template's own designJson. Null = product URLs 404 like any unmatched path,
  // same safe-by-default shape as BlogSite's layout fields being null.
  productDetailTemplateId String?   @unique @db.Uuid
  productDetailTemplate   Template? @relation("CommerceProductDetailLayout", fields: [productDetailTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Idempotency guard for the Paystack webhook — id is Paystack's own transaction id
// (event.data.id). A unique-constraint failure on create means "already handled," ack
// and stop. Same defensive shape as claimStripeEvent. Scoped by templateId because
// Paystack keys (and therefore the webhook URL) are per-site, not per-org — see
// CommerceSettings.
model PaystackWebhookEvent {
  id             String   @id
  templateId     String   @db.Uuid
  organizationId String   @db.Uuid
  receivedAt     DateTime @default(now())

  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([organizationId])
}

// Idempotency guard for the platform-hosted Commerce Stripe webhook (app/api/webhooks/
// stripe/commerce/route.ts). Deliberately separate from StripeEvent, which claims events
// from Plexo's own SaaS-billing Stripe account/webhook — these are two different Stripe
// accounts and event streams, and must never share one claim table.
model StripeCommerceEvent {
  id         String   @id
  receivedAt DateTime @default(now())
}

// Idempotency guard for the platform-hosted Commerce Paystack webhook (app/api/webhooks/
// paystack/platform/route.ts) — a single webhook URL for every site's PLATFORM_PAYSTACK
// orders (money all lands in one Plexo-owned account), unlike the per-site
// PaystackWebhookEvent used for BYO_PAYSTACK. Claims by Paystack's own event id alone,
// with no templateId/organizationId to scope by.
model PlatformPaystackWebhookEvent {
  id         String   @id
  receivedAt DateTime @default(now())
}

// Commerce wallet — holds the running balance for orders processed through Plexo's own
// Paystack/Stripe account (CommercePaymentProvider PLATFORM_PAYSTACK/PLATFORM_STRIPE).
// Balance tracking only for v1: no automated bank-transfer API, a withdrawal is a logged
// CommerceWithdrawalRequest an admin processes manually (same shape/limitation as the
// template-marketplace's own WithdrawalRequest).
//
// Site-scoped by default (templateId set) — one wallet per storefront, matching every
// other Commerce setting (Paystack keys, MailDrip account are all per-site, never pooled
// implicitly). templateId is null ONLY for an org's single POOLED wallet, which exists
// when Organization.commerceWalletPooled is true — in that mode every site under the org
// credits this one row instead of its own. resolveCommerceWallet() (lib/commerce/wallet.ts)
// is the only place that decides which row a given site's sale credits into; never resolve
// a wallet by templateId alone without going through it. The DB does not enforce "at most
// one pooled wallet per org" (Postgres treats each NULL templateId as distinct) —
// resolveCommerceWallet() enforces that at the app layer with a find-before-create check.
model CommerceWallet {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  templateId     String?  @unique @db.Uuid
  balanceCents   Int      @default(0)
  currency       String   @default("NGN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template?    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ledger       CommerceWalletLedgerEntry[]
  withdrawals  CommerceWithdrawalRequest[]

  @@index([organizationId])
}

enum CommerceWalletLedgerType {
  SALE_CREDIT
  WITHDRAWAL_DEBIT
  WITHDRAWAL_REVERSAL
}

// Mirrors SellerLedgerEntry's shape exactly (see that model's own comments), scoped to a
// CommerceWallet instead of a User.
model CommerceWalletLedgerEntry {
  id                  String                    @id @default(uuid()) @db.Uuid
  walletId            String                    @db.Uuid
  type                CommerceWalletLedgerType
  grossAmountCents    Int?
  feeCents            Int?
  netAmountCents      Int
  balanceAfterCents   Int
  orderId             String?                   @db.Uuid
  withdrawalRequestId String?                   @db.Uuid
  description         String?
  createdAt           DateTime                  @default(now())

  wallet CommerceWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  CommerceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([orderId])
}

enum CommerceWithdrawalStatus {
  PENDING
  PROCESSED
  REJECTED
}

// Manual bank-transfer payout request — identical shape/semantics to WithdrawalRequest
// (see that model's own comments); an admin processes it outside the system, no automated
// transfer API in v1.
model CommerceWithdrawalRequest {
  id                         String                    @id @default(uuid()) @db.Uuid
  walletId                   String                    @db.Uuid
  organizationId             String                    @db.Uuid
  requestedByUserId          String                    @db.Uuid
  amountCents                Int
  encryptedAccountNumber     String
  encryptedAccountHolderName String
  bankName                   String
  status                     CommerceWithdrawalStatus @default(PENDING)
  // Required at the app layer when status is set to REJECTED — not a DB constraint.
  rejectionReason            String?
  requestedAt                DateTime                  @default(now())
  processedAt                DateTime?
  processedByAdminId         String?                   @db.Uuid

  wallet       CommerceWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User           @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([organizationId])
  @@index([status])
}

enum CommerceStripeAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

// Gates CommercePaymentProvider.PLATFORM_STRIPE — an org must have an APPROVED row here
// before any site it owns can select platform Stripe (enforced in the settings PUT route,
// not here). Org-scoped, not per-site: Stripe-account approval is a business-level
// decision, matching CommerceWallet's own default org-vs-site reasoning. Same request/
// approve split as ScriptAccessRequest — the approve/reject mutation lives in plexo-admin,
// this repo only ever writes PENDING and reads the resulting status.
model CommerceStripeAccessRequest {
  id                 String                      @id @default(uuid()) @db.Uuid
  organizationId     String                      @db.Uuid
  requestedByUserId  String                      @db.Uuid
  // Short free-text reason/expected-volume the requester gave — shown to the reviewing admin.
  reason             String?
  expectedVolume     String?
  status             CommerceStripeAccessStatus @default(PENDING)
  requestedAt        DateTime                    @default(now())
  processedAt        DateTime?
  processedByAdminId String?                     @db.Uuid
  // Required at the app layer when status is set to REJECTED — not a DB constraint.
  rejectionReason    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

// A submission from a real form_container (see sanitizeCompiledHtml's FIX-004 — form/input/
// textarea/select now survive publish, so a form_container's action can point straight at
// /api/public/forms/[templateId]/submit and actually receive a plain, no-JS browser POST).
// fields is a Json bag rather than fixed name/email/message columns since a form_container's
// own field list is fully author-defined (any mix of text/email/number/date/textarea/select/
// radio/checkbox, any names) — there is no fixed shape to normalize into.
model FormSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  templateId     String   @db.Uuid
  organizationId String   @db.Uuid
  formName       String   @default("Website Form")
  fields         Json
  submitterIp    String?
  createdAt      DateTime @default(now())

  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([organizationId])
}

// One consolidated row per organization — a single "Notifications" section on the General
// settings page, applying across every site the org owns, rather than a separate toggle
// buried in each feature's own settings. Only ever covers genuinely discretionary
// notifications about activity; account-security mail (email verification, password
// reset) and delivery mechanisms a person is actively waiting on (org invites, site
// transfer requests) are never gated here — see each field's own comment for what it
// actually controls and its default.
model NotificationPreferences {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  // New — app/api/public/forms/[templateId]/submit. Off by default: this notification
  // never existed before, so every existing site defaulting to "on" would mean everyone
  // suddenly starts getting emailed without having asked for it.
  formSubmissions Boolean @default(false)
  // Already sends today (app/api/blog-comments/route.ts's notifySiteOwner) — on by
  // default so turning this feature into a toggle doesn't silently change existing
  // behavior for anyone already relying on it.
  blogComments    Boolean @default(true)
  // CommerceSettings.notificationEmail has existed as a stored field since Commerce
  // shipped but was never actually wired to send anything — this toggle is what finally
  // gates the real send (Paystack webhook, on a successful charge). On by default: a site
  // owner very likely wants to know when they've been paid.
  payments        Boolean @default(true)
  // Existing behavior (app/api/v1/comments/route.ts) — someone @mentioned you in a
  // template's internal comment thread. On by default, same reasoning as blogComments.
  commentMentions Boolean @default(true)

  // Overrides where every notification above is sent — null falls back to the
  // organization owner's own account email (User.email) at send time, only actually
  // stored here once someone points it somewhere else (e.g. a shared team inbox).
  notificationEmail String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum CommerceReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Fast-follow feature (see the Commerce plan) — moderated, same shape as MailDrip's own
// comment moderation: pending until an admin approves.
model CommerceProductReview {
  id             String               @id @default(uuid()) @db.Uuid
  templateId     String               @db.Uuid
  organizationId String               @db.Uuid
  productId      String               @db.Uuid
  customerEmail  String
  rating         Int
  body           String?
  status         CommerceReviewStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([organizationId])
  @@index([productId])
}
