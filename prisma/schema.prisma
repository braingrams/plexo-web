generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TemplateKind {
  EMAIL
  LANDING_PAGE
}

// BUILDER: page assembled from designJson via the visual builder (existing flow).
// RAW_UPLOAD: user-supplied HTML/CSS/JS uploaded as-is (single .html or a .zip site),
// served verbatim with no sanitization — see server/rawUpload.ts for the isolation
// story that makes this safe (dedicated plexopages.io origin, see middleware.ts).
enum TemplateSourceType {
  BUILDER
  RAW_UPLOAD
}

enum SubscriptionPlan {
  FREE
  PRO
  ULTRA
}

enum AiTier {
  AUTO
  BASIC
  MEDIUM
  HIGH
}

enum LayoutMode {
  CLASSIC
  MODERN
}

enum CreditTransactionType {
  MONTHLY_GRANT
  TOPUP_PURCHASE
  AI_USAGE
  REFUND
  ADJUSTMENT
}

// SYSTEM: Plexo's own credit ledger pays (default).
// BYOK: the account's own provider key pays, no credits touched.
// HOST_MANAGED: the embedding host app authorizes + charges its own users for
// every AI action via a webhook (see lib/ai/hostAuthorization.ts) — Plexo never
// touches its own ledger for this key and never knows the host's credit model.
enum AiAccessMode {
  SYSTEM
  BYOK
  HOST_MANAGED
}

enum NotificationType {
  MENTION
  COMMENT_REPLY
  COMMENT_RESOLVED
  INVITE_ACCEPTED
}

// Owned by better-auth's organization() plugin (server/auth.ts, server/accessControl.ts).
// Member.role is a plain string matching one of accessControl.ts's role ids
// ("owner" | "admin" | "editor" | "commenter" | "viewer") — validated at the app layer via
// the plugin's access-control statements, not enforced as a DB enum, since better-auth
// itself treats roles as strings (see roleSchema in its own schema).
model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  logo       String?
  // White-label accent color (hex, e.g. "#4f46e5") — null falls back to the default Plexo
  // purple everywhere it's read (dashboard chrome, transactional emails, embedded SDK).
  // Gated to Pro/Ultra: see lib/subscription.ts's canWhiteLabel + getOrganizationOwnerPlan.
  brandColor String?
  // Explicit opt-in for replacing the Plexo name/logo/color with the org's own — being on a
  // Pro/Ultra plan only makes this ELIGIBLE (see canWhiteLabel), it does not turn it on by
  // itself. Defaults false for every org, including ones that already had a logo/brandColor
  // set under the old automatic-on-Pro/Ultra behavior.
  whiteLabelEnabled Boolean @default(false)
  metadata   String?
  createdAt  DateTime @default(now())

  members          Member[]
  invitations      Invitation[]
  templates        Template[]
  apiKeys          ApiKey[]
  publishedDomains PublishedDomain[]
  uploadedImages   UploadedImage[]
  comments         Comment[]
  notifications    Notification[]
}

model Member {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  role           String
  status         String   @default("pending")
  inviterId      String   @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// Figma-style anchored comments on the PlexoBuilder canvas. anchorNodeId is a
// RowJSON/ColumnJSON/ElementJSON.id from the template's designJson; null means a
// template-level (unanchored) comment. See plexo-sdk's data-plexo-node-id +
// getNodeRect() additions for how the pin's on-screen position is resolved.
model Comment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  templateId     String    @db.Uuid
  authorId       String    @db.Uuid
  parentId       String?   @db.Uuid
  body           String    @db.Text
  anchorNodeId   String?
  anchorNodeType String?
  anchorX        Float?
  anchorY        Float?
  deviceView     String?
  resolvedAt     DateTime?
  resolvedById   String?   @db.Uuid
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  author       User             @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolvedBy   User?            @relation("CommentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent       Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]        @relation("CommentReplies")
  mentions     CommentMention[]

  @@index([templateId])
  @@index([organizationId])
  @@index([parentId])
}

model CommentMention {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

// Backs both the in-app notification bell and the trigger for mention/reply emails
// (see lib/mail/templates.ts's buildMentionEmail/buildCommentReplyEmail).
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  actorId        String?          @db.Uuid
  commentId      String?          @db.Uuid
  templateId     String?          @db.Uuid
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([organizationId])
}

// Owned by plexo-admin (a separate app, same database) — see plexo-admin/prisma/schema.prisma
// for the copy it builds against and plexo-admin/README.md for the two-repo schema-sync
// process. null on User.adminRole = ordinary customer; non-null = staff member permitted
// into the admin app.
enum AdminRole {
  SUPERADMIN
  SUPPORT
  MODERATOR
  FINANCE
}

model User {
  id                          String            @id @default(uuid()) @db.Uuid
  name                        String            @default("Plexo User")
  image                       String?
  email                       String            @unique
  passwordHash                String            @default("")
  isConfirmed                 Boolean           @default(false)
  // Was @default(ULTRA) pre-Phase-2 (free beta, no billing). Now that plan
  // determines real monthly AI credit allowance, new signups default to FREE.
  subscriptionPlan            SubscriptionPlan  @default(FREE)
  // Set at signup when the user picks Pro/Ultra on the pricing page, before they've paid —
  // durably records intent across the signup -> verify-email -> first-login gap (which can
  // span devices/time) since no session exists yet at signup time to persist this any other
  // way (see server/auth.ts's databaseHooks). Cleared once the Stripe webhook confirms payment
  // (or the user explicitly opts to continue on Free) — see app/dashboard/page.tsx's gate and
  // app/auth/complete-subscription.
  pendingPlan                 SubscriptionPlan?
  customDomainLimit           Int?
  // Timestamp of accepting the Acceptable Use Policy — required before a user's first
  // unsanitized raw-HTML publish (see app/api/v1/templates/upload-raw/route.ts).
  aupAcceptedAt               DateTime?
  // Ultra-gated: lets embedded SDK builders publish/AI under this account without a
  // per-account domain limit. Enforcement of the Ultra requirement happens in app code
  // (see lib/subscription.ts resolveManageLandingPagePublishing), not at the DB layer.
  manageLandingPagePublishing Boolean           @default(false)
  // Pro/Ultra-gated: hides the "Hosted with Plexo" bar injected into BUILDER pages served on
  // the shared plexopages.io subdomain (see app/pub/[domain]/[[...slug]]/route.ts). Collapsed
  // with plan entitlement via lib/subscription.ts's resolveHideBranding, same pattern as
  // resolveManageLandingPagePublishing, so a stale true after a downgrade doesn't leak through.
  hideBranding                Boolean           @default(false)
  layoutMode                  LayoutMode        @default(MODERN)
  // Strata design-system project the user has connected — lets AI tooling (MCP) auto-detect
  // and fetch brand tokens without the user re-supplying a project id on every call.
  strataProjectId             String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  // Billing / credits (Phase 2)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  allowanceBalance     Int      @default(0)
  topupBalance         Int      @default(0)
  allowanceResetAt     DateTime @default(now())

  // Marketplace seller earnings (real money, cents) — distinct from the AI-credit
  // balances above. Reserved (debited) the moment a withdrawal is requested, not when
  // it's processed, so a seller can't request more than their available balance across
  // several pending requests at once. See lib/marketplaceListing.ts / SellerLedgerEntry.
  sellerBalanceCents Int @default(0)

  // Owned by plexo-admin: null = ordinary customer, non-null = staff member. See the
  // AdminRole enum's comment above.
  adminRole AdminRole?

  // Owned by plexo-admin: account-wide suspend/reinstate, distinct from a single
  // PublishedDomain's own active/suspendedAt. NOTE: this repo (plexo-web) does not yet
  // check suspendedAt anywhere (sign-in, resolveUser, /pub serving) — setting it from
  // the admin app currently records intent/audit only. A follow-up here should check it
  // in server/auth.ts's sign-in hook and in app/api/v1/**'s resolveUser() before this is
  // a real enforcement mechanism.
  suspendedAt     DateTime?
  suspendedReason String?

  apiKeys          ApiKey[]
  templates        Template[]
  accounts         Account[]
  sessions         Session[]
  publishedDomains PublishedDomain[]
  uploadedImages   UploadedImage[]
  creditLedger     CreditLedgerEntry[]
  adminAuditLogs   AdminAuditLog[]

  memberships            Member[]
  sentInvitations        Invitation[]
  comments               Comment[]        @relation("CommentAuthor")
  resolvedComments       Comment[]        @relation("CommentResolvedBy")
  commentMentions        CommentMention[]
  notifications          Notification[]   @relation("NotificationRecipient")
  triggeredNotifications Notification[]   @relation("NotificationActor")
  templatePurchases       TemplatePurchase[]
  sellerLedger            SellerLedgerEntry[]
  withdrawalRequests      WithdrawalRequest[]
  feedback                Feedback[]
}

model CreditLedgerEntry {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  type          CreditTransactionType
  amount        Int // positive = credit added, negative = credit spent
  balanceAfter  Int
  description   String?
  stripeEventId String?
  metadata      Json?
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeEventId])
}

// Idempotency guard for Stripe webhook deliveries — insert the event id before
// processing; a unique-constraint violation means it's already been handled.
model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// Singleton row (fixed id "global") for platform-wide toggles configurable from
// plexo-admin. Read by lib/marketplaceListing.ts's submitTemplateForMarketplace to decide
// whether a new user-submitted listing needs admin approval (PENDING_REVIEW, the default)
// or goes live immediately (PUBLISHED) — off by default, matching the moderation-first
// design; an admin can flip it on from a settings toggle.
model PlatformSettings {
  id                             String   @id @default("global")
  autoPublishMarketplaceListings Boolean  @default(false)
  // Basis points (1/100th of a percent) — 2000 = 20.00%. Int, not Float, to avoid
  // floating-point rounding when computing fee/net cents on every sale. Read by the
  // Stripe webhook's creditMarketplaceSeller (lib/marketplaceListing.ts).
  marketplaceFeeBps              Int      @default(2000)
  updatedAt                      DateTime @updatedAt
}

enum SellerLedgerType {
  SALE_CREDIT
  WITHDRAWAL_DEBIT
  WITHDRAWAL_REVERSAL
}

// Ledger of every change to User.sellerBalanceCents — mirrors CreditLedgerEntry's shape
// (see lib/credits/ledger.ts), same purpose: an auditable trail alongside the plain
// running balance. gross/fee are only set on SALE_CREDIT rows (kept for audit — Plexo's
// 20% platform fee is visible per-sale); net is what actually moved the balance on every
// row type.
model SellerLedgerEntry {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  type               SellerLedgerType
  grossAmountCents   Int?
  feeCents           Int?
  netAmountCents     Int
  balanceAfterCents  Int
  templatePurchaseId String?          @db.Uuid
  withdrawalRequestId String?         @db.Uuid
  description        String?
  createdAt          DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templatePurchaseId])
  @@index([withdrawalRequestId])
}

enum WithdrawalStatus {
  PENDING
  PROCESSED
  REJECTED
}

// Manual bank-transfer payout request — the app only tracks status; an admin actually
// sends the money outside this system. Account number / holder name are encrypted at
// rest via lib/crypto.ts's encryptSecret/decryptSecret (same pattern as ApiKey.aiApiKey);
// bank name is left plain since it isn't independently sensitive.
model WithdrawalRequest {
  id                          String           @id @default(uuid()) @db.Uuid
  userId                      String           @db.Uuid
  amountCents                 Int
  encryptedAccountNumber      String
  encryptedAccountHolderName  String
  bankName                    String
  status                      WithdrawalStatus @default(PENDING)
  // Required at the app layer when status is set to REJECTED — not a DB constraint.
  rejectionReason             String?
  requestedAt                 DateTime         @default(now())
  processedAt                 DateTime?
  processedByAdminId          String?          @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  name           String
  hashedKey      String
  maskedKey      String
  useAi          Boolean   @default(false)
  aiProvider     String    @default("openai")
  aiTier         AiTier    @default(AUTO)
  aiApiKey       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  // Host-Managed AI access (Phase 3): lets an embedding host app own AI
  // authorization/billing for its own end users instead of Plexo's ledger.
  // hostAuthWebhookUrl/hostWebhookSecret are only read when aiAccessMode is
  // HOST_MANAGED; hostWebhookSecret is encrypted at rest like aiApiKey and
  // never echoed back to the client (see app/api/settings/api-keys).
  aiAccessMode       AiAccessMode @default(SYSTEM)
  hostAuthWebhookUrl String?
  hostWebhookSecret  String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model Template {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  organizationId String             @db.Uuid
  name           String
  kind           TemplateKind
  // RAW_UPLOAD templates have an empty/placeholder designJson (nothing to edit in the
  // builder) — compiledHtml holds the uploaded index.html verbatim, unsanitized;
  // additional files (css/js/images) live in TemplateAsset.
  sourceType     TemplateSourceType @default(BUILDER)
  designJson     Json
  compiledHtml   String             @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Multipage support: a LANDING_PAGE template with parentId == null is a
  // standalone/home page (the thing a PublishedDomain links to, unchanged
  // from pre-multipage behavior). A non-null parentId makes this row a
  // sub-page reachable at <domain>/<slug> under its parent — and since the
  // parent can itself be a sub-page, arbitrary nesting (/blog/post-1) falls
  // out of this self-relation without any extra modeling.
  parentId String? @db.Uuid
  // One path segment (e.g. "post-1"), not the full path. Null for root pages.
  slug     String?
  order    Int     @default(0)

  // Marks this as a genuinely public, platform-curated template — distinct from userId, which
  // is just whoever owns the row. Only flippable via the email-allowlisted admin route (see
  // app/api/admin/templates/[id]/official/route.ts); /api/v1/public-templates queries this
  // platform-wide, unscoped by owner, which is the whole point of it being "public."
  isOfficial Boolean @default(false)

  // Template marketplace: owned by plexo-admin (curation) and served here by
  // app/marketplace (browse/filter) + app/api/v1/marketplace/** (list/purchase/use).
  // null marketplaceStatus = an ordinary, non-marketplace Template (nearly all rows).
  // "type" filter on the public page is TemplateKind (kind, above); marketplaceCategory
  // is a free-text tag plexo-admin sets, no separate taxonomy table.
  marketplaceStatus      MarketplaceStatus?
  marketplaceCategory    String?
  marketplaceDescription String?
  // Cents; 0 or null = free. Int, not Float, to avoid floating-point cent errors.
  priceCents             Int?
  marketplacePublishedAt DateTime?
  // Optional note an admin may leave when rejecting a user-submitted listing (PENDING_REVIEW
  // -> REJECTED). Not required, unlike WithdrawalRequest.rejectionReason — admin-curated
  // listings never use this at all.
  marketplaceRejectionReason String?

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           Template?          @relation("TemplatePages", fields: [parentId], references: [id], onDelete: Cascade)
  pages            Template[]         @relation("TemplatePages")
  publishedDomains PublishedDomain[]
  pageViews        PageView[]
  assets           TemplateAsset[]
  comments         Comment[]
  purchases        TemplatePurchase[]

  @@unique([parentId, slug])
  @@index([userId])
  @@index([organizationId])
  @@index([parentId])
  @@index([marketplaceStatus])
}

enum MarketplaceStatus {
  DRAFT
  // User-submitted listing awaiting admin review — see PlatformSettings.
  // autoPublishMarketplaceListings for the opt-out.
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum TemplateGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

// Tracks one admin-triggered "Generate Templates with AI" batch (plexo-admin). Processed
// incrementally in chunks (see plexo-admin's lib/generation/job.ts) rather than in one
// long-running request, so progress survives a serverless invocation timeout — lockedAt
// is a heartbeat preventing the cron tick and a manual "process now" click from double-
// processing the same job concurrently.
model TemplateGenerationJob {
  id                 String                   @id @default(uuid()) @db.Uuid
  status             TemplateGenerationStatus @default(PENDING)
  kind               TemplateKind
  isOptIn            Boolean                  @default(false)
  category           String
  priceCents         Int                      @default(0)
  targetStatus       MarketplaceStatus
  provider           String // "anthropic_claude" | "openai" | "google_gemini"
  requestedCount     Int
  succeededCount     Int                      @default(0)
  failedCount        Int                      @default(0)
  createdTemplateIds String[]                 @default([])
  errors             Json?
  lockedAt           DateTime?
  createdBy          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([status])
}

// One row per user who has unlocked a marketplace template (paid or claimed-free) — the
// gate app/api/v1/marketplace/templates/[id]/use checks before letting someone duplicate
// a marketplace template into their own account. Free templates still get a row
// (priceCentsPaid 0) so "already own this"/"my library" checks don't special-case free.
model TemplatePurchase {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  templateId      String   @db.Uuid
  priceCentsPaid  Int
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([templateId])
}

// Non-root files belonging to a RAW_UPLOAD template (style.css, app.js, images, fonts...).
// The root document itself stays in Template.compiledHtml so the common case (single
// self-contained .html upload) needs no blob storage at all.
model TemplateAsset {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  path        String // relative path as referenced in the HTML, e.g. "style.css", "assets/logo.png"
  blobUrl     String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, path])
  @@index([templateId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Required by better-auth's organization() plugin (server/auth.ts) — tracks which
  // org a multi-membership user is currently "in", set via auth.api.setActiveOrganization
  // (see server/org.ts's ensureActiveOrganization). Plain string, not a Prisma relation,
  // matching Member.role's same "better-auth owns the semantics" convention.
  activeOrganizationId String? @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
}

// better-auth's own rate-limit storage (server/auth.ts rateLimit.storage: "database") —
// required so rate limiting is actually shared across serverless instances instead of
// each one keeping its own in-memory counter (the framework default), which would let
// an attacker bypass limits simply by landing on a different warm instance.
// lastRequest MUST be BigInt, not Int: it stores Date.now() (epoch milliseconds), which
// overflows a 32-bit Int. Confirmed against better-auth's own adapter code, which
// explicitly normalizes a bigint lastRequest value read back from the DB.
model RateLimit {
  id          String @id @default(cuid())
  key         String
  count       Int
  lastRequest BigInt

  @@index([key])
}

model PublishedDomain {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  templateId     String   @db.Uuid
  domain         String   @unique
  type           String // "SUBDOMAIN" | "CUSTOM"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Persisted DNS verification (previously only lived in transient client state, so a
  // page reload always reverted CUSTOM domains to "Check DNS" even after a successful check).
  dnsVerified   Boolean   @default(false)
  dnsVerifiedAt DateTime?

  // Takedown / abuse-scan state (see lib/safeBrowsing.ts, app/api/internal/domains/[id]/suspend).
  // /pub refuses to serve content for a domain with active=false.
  active          Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  flagged         Boolean   @default(false)
  flagReason      String?
  lastScannedAt   DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([templateId])
  @@index([domain])
}

model PageView {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  domain     String? // tracks which subdomain/custom domain was visited
  ipHash     String? // sha-256 hash of visitor IP for unique counting — raw IP is never stored
  userAgent  String? // browser/device information
  // Derived from Vercel's geolocation headers (free, no third-party API) — coarse
  // country/region/city only, never the raw IP that produced them.
  country    String?
  region     String?
  city       String?
  // Parsed from userAgent at write time so the dashboard can filter/display without
  // re-parsing the raw string per row.
  deviceType String? // "mobile" | "tablet" | "desktop"
  browser    String?
  os         String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([createdAt])
}

model UploadedImage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  name           String
  url            String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model StockCache {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String // "unsplash" | "pexels" | "pixabay"
  query     String // search query
  results   Json // JSON array of cached StockImageResult[]
  createdAt DateTime @default(now())

  @@unique([provider, query])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id        String            @id @default(uuid()) @db.Uuid
  quote     String
  name      String
  role      String
  company   String?
  avatarUrl String?
  rating    Int               @default(5)
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ARCHIVED
}

// User-submitted product feedback — see app/dashboard/_components/FeedbackButton.tsx
// (plexo-web) and app/(dashboard)/feedback (plexo-admin's triage queue).
model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  // Denormalized snapshot at submission time so feedback stays attributable/readable in
  // the admin even if the account is later renamed or deleted — userId is SetNull, not
  // Cascade, for the same reason: the feedback itself is still worth keeping.
  userEmail String
  userName  String
  message   String         @db.Text
  pageUrl   String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

// Owned by plexo-admin entirely: one row per mutating admin action, written by
// plexo-admin/server/audit.ts's writeAuditLog(). Never mutated or deleted after creation.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String   @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
