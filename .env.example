# Copy this file to .env and fill in real values. See README.md for setup details.

# Neon pooled URL for application/runtime queries (recommended for serverless workloads).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon direct URL for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# "Continue with Google" — since the DynamoDB/Auth.js cutover (server/authDynamo.ts) this
# no longer talks to Google directly. It goes through Charisol's centralized, Cognito-fronted
# Google IdP (@charisol/auth-sdk-web in app/auth/GoogleAuthButton.tsx +
# app/auth/charisol/callback/page.tsx), so Plexo never holds a Google client ID/secret.
# Register Plexo as an app in the Charisol Developer Portal (docs/onboarding-guide.md in
# the Charisol Auth repo) to get CLIENT_ID — DOMAIN is auth.charisol.io, the pool's real
# custom domain (the portal's own Quick Start snippet shows the raw Cognito default domain
# instead, but auth.charisol.io — also @charisol/auth-sdk-web's own default — is correct).
# Add both `http://localhost:3000/auth/charisol/callback`
# and the production `https://plexo.charisol.io/auth/charisol/callback` as redirect URIs on
# that app, and the equivalent `.../auth/login` pair as its logout URIs
# (lib/charisolAuth.ts's logoutRedirectUri — powers single logout on sign-out, not just
# sign-in). New apps land in `pending_review` until a Charisol admin approves them — sign-in
# won't work until then. USER_POOL_ID is the CharisolAuthProductsStack's UserPoolId output,
# not shown on the app card (needed server-side so server/authDynamo.ts's charisolVerifier
# can check aud/client_id, not just the signature — the pool is shared across every
# Charisol product). Real values live in SSM at /plexo/<env>/..., pushed there via the
# "Sync Secrets to SSM" GitHub Actions workflow.
AUTH_SECRET=""
NEXT_PUBLIC_CHARISOL_CLIENT_ID=""
NEXT_PUBLIC_CHARISOL_DOMAIN="auth.charisol.io"
CHARISOL_USER_POOL_ID=""

# AES-256-GCM key used to encrypt BYOK provider keys (ApiKey.aiApiKey) at rest.
# Rotating this value invalidates all previously-stored AI keys — re-run
# `npm run ai:encrypt-keys` only re-encrypts legacy plaintext, it does not
# migrate keys encrypted under an old secret.
AI_KEY_ENCRYPTION_SECRET="generate-a-random-32-byte-base64-secret"

# Encrypts WithdrawalRequest bank details (account number, holder name) — deliberately a
# SEPARATE secret from AI_KEY_ENCRYPTION_SECRET above, so a leak of one never exposes the
# other. plexo-admin needs the exact same value to decrypt these for admin review.
BANK_DETAILS_ENCRYPTION_SECRET="generate-a-different-random-32-byte-base64-secret"

# Encrypts each Commerce site's own Paystack secret key — again a SEPARATE secret from
# both of the above, same isolation rationale (a leak of one never exposes the others).
PAYSTACK_KEY_ENCRYPTION_SECRET="generate-yet-another-random-32-byte-base64-secret"

# Encrypts each Commerce site's own MailDrip API key (used instead of the platform-wide
# MAILDRIP_API_KEY below when a site has connected its own MailDrip account) — same
# isolation rationale as the three secrets above.
MAILDRIP_KEY_ENCRYPTION_SECRET="generate-still-another-random-32-byte-base64-secret"

# Encrypts a digital Commerce product's optional ACCESS_LIST password
# (CommerceProduct.digitalAccessPasswordEncrypted) — same isolation rationale as the four
# secrets above.
COMMERCE_DIGITAL_ACCESS_ENCRYPTION_SECRET="generate-yet-another-random-32-byte-base64-secret"

# Plexo's own platform-hosted Commerce payment accounts (CommercePaymentProvider
# PLATFORM_PAYSTACK / PLATFORM_STRIPE) — used instead of a site's own BYO keys when a site
# opts into platform-hosted payments. Proceeds credit the site's CommerceWallet.
PLATFORM_PAYSTACK_PUBLIC_KEY=""
PLATFORM_PAYSTACK_SECRET_KEY=""
PLATFORM_COMMERCE_STRIPE_SECRET_KEY=""
PLATFORM_COMMERCE_STRIPE_WEBHOOK_SECRET=""

# Maildrip transactional email API
MAILDRIP_API_URL="https://api.maildrip.io/api/v1/emails/transaction"
MAILDRIP_API_KEY=""

# Pusher Channels — powers realtime comment/notification updates (see lib/realtime/pusher.ts).
# Create a free app at https://dashboard.pusher.com/. Without these set, comments and the
# notification bell still work but only update on page reload/refetch, not live.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
# Same Pusher app's key/cluster, exposed to the browser (see lib/realtime/pusherClient.ts).
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Comma-separated allowlist of session emails permitted to curate official public templates
# via PATCH /api/admin/templates/[id]/official. There's no admin/role system in this app —
# this is a lightweight allowlist, not a full permissions model.
ADMIN_EMAILS=""

# Client-side app URL for auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

VERCEL_AUTH_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Phase 2: System-AI credits & Stripe billing ---
# See README.md "Phase 2 billing setup" for how to obtain each of these.

# Stripe secret key (test mode to start) and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — created in the Stripe Dashboard, one recurring price per
# paid plan and one one-off price per credit top-up pack.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=

# Which provider "system AI" (accounts without their own BYOK key) uses. One
# of: anthropic_claude | openai | google_gemini. All three SYSTEM_AI_KEY_*
# vars below can be provisioned at once — switching providers is just this
# one value, no code change, no redeploy of secrets.
SYSTEM_AI_PROVIDER=anthropic_claude
SYSTEM_AI_KEY_ANTHROPIC_CLAUDE=
SYSTEM_AI_KEY_OPENAI=
SYSTEM_AI_KEY_GOOGLE_GEMINI=

# USD value of a single credit — the configurable credit<->dollar ratio.
# Default: 1000 credits = $1.
CREDIT_USD_VALUE=0.001

# Browserbase — managed headless-browser rendering used by the "import a website" feature
# for JS-heavy pages (see lib/siteImport/headlessFetch.ts). Only the API key is needed; no
# project id — Browserbase resolves the project from the key itself.
BROWSERBASE_API_KEY=
