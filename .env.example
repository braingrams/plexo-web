# Copy this file to .env and fill in real values. See README.md for setup details.

# Neon pooled URL for application/runtime queries (recommended for serverless workloads).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon direct URL for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# AES-256-GCM key used to encrypt BYOK provider keys (ApiKey.aiApiKey) at rest.
# Rotating this value invalidates all previously-stored AI keys — re-run
# `npm run ai:encrypt-keys` only re-encrypts legacy plaintext, it does not
# migrate keys encrypted under an old secret.
AI_KEY_ENCRYPTION_SECRET="generate-a-random-32-byte-base64-secret"

# Encrypts WithdrawalRequest bank details (account number, holder name) — deliberately a
# SEPARATE secret from AI_KEY_ENCRYPTION_SECRET above, so a leak of one never exposes the
# other. plexo-admin needs the exact same value to decrypt these for admin review.
BANK_DETAILS_ENCRYPTION_SECRET="generate-a-different-random-32-byte-base64-secret"

# Maildrip transactional email API
MAILDRIP_API_URL="https://api.maildrip.io/api/v1/emails/transaction"
MAILDRIP_API_KEY=""

# Pusher Channels — powers realtime comment/notification updates (see lib/realtime/pusher.ts).
# Create a free app at https://dashboard.pusher.com/. Without these set, comments and the
# notification bell still work but only update on page reload/refetch, not live.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
# Same Pusher app's key/cluster, exposed to the browser (see lib/realtime/pusherClient.ts).
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Comma-separated allowlist of session emails permitted to curate official public templates
# via PATCH /api/admin/templates/[id]/official. There's no admin/role system in this app —
# this is a lightweight allowlist, not a full permissions model.
ADMIN_EMAILS=""

# Client-side app URL for auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

VERCEL_AUTH_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Phase 2: System-AI credits & Stripe billing ---
# See README.md "Phase 2 billing setup" for how to obtain each of these.

# Stripe secret key (test mode to start) and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — created in the Stripe Dashboard, one recurring price per
# paid plan and one one-off price per credit top-up pack.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=

# Which provider "system AI" (accounts without their own BYOK key) uses. One
# of: anthropic_claude | openai | google_gemini. All three SYSTEM_AI_KEY_*
# vars below can be provisioned at once — switching providers is just this
# one value, no code change, no redeploy of secrets.
SYSTEM_AI_PROVIDER=anthropic_claude
SYSTEM_AI_KEY_ANTHROPIC_CLAUDE=
SYSTEM_AI_KEY_OPENAI=
SYSTEM_AI_KEY_GOOGLE_GEMINI=

# USD value of a single credit — the configurable credit<->dollar ratio.
# Default: 1000 credits = $1.
CREDIT_USD_VALUE=0.001

# Browserbase — managed headless-browser rendering used by the "import a website" feature
# for JS-heavy pages (see lib/siteImport/headlessFetch.ts). Only the API key is needed; no
# project id — Browserbase resolves the project from the key itself.
BROWSERBASE_API_KEY=
