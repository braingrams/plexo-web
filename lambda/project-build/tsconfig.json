{
  // Its own TypeScript project (like cdk/): the build Lambda has its own package.json and
  // node_modules, installed in its Docker image and by CI — never by the Next.js app's build.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../lib/projects/buildJob.ts", "../../lib/projects/diagnostics.ts"]
}
