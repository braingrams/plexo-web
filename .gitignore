# cdk
cdk/cdk.out/

# OpenNext build output — regenerated by `npx @opennextjs/aws build`, not source
.open-next/

# Runtime progress-tracking state for scripts/migration/*.ts — regenerated per run,
# never meant to be committed (and would otherwise leak real Postgres row ids/cursors).
.migration-checkpoint-*.json

# cdk.json runs the app straight via ts-node (see cdk/cdk.json) — `npm run build` inside
# cdk/ (plain tsc) is only ever a typecheck sanity check, never part of the real deploy
# path, but its outDir ("./lib") sits inside the same tree as the source .ts files it
# reads (bin/ and lib/), so a stray local `npm run build` nests real compiled output at
# cdk/lib/bin/ and cdk/lib/lib/ right next to hand-written source. Never commit that output.
cdk/lib/bin/
cdk/lib/lib/

# Claude Code's own local session/worktree state — not project source.
.claude/

# Ad-hoc one-off scratch scripts, never meant to be committed.
.tmp-scripts/
