{
  "openapi": "3.1.0",
  "info": {
    "title": "Plexo AI Page Builder & Publishing API",
    "description": "API for creating, compiling, and publishing landing pages, managing email templates, and inspecting analytics on Plexo.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://plexobuilder.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/v1/publish": {
      "post": {
        "summary": "Generate and Publish Landing Page",
        "description": "Creates a Plexo landing page template (JSON schema and auto-compiled HTML) and binds it to a subdomain or custom domain in 1 step.",
        "operationId": "publishLandingPage",
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["designJson"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name or title of the landing page",
                    "example": "Acme AI CRM Landing Page"
                  },
                  "designJson": {
                    "type": "object",
                    "description": "Plexo drag-and-drop JSON canvas layout object containing body style and rows"
                  },
                  "compiledHtml": {
                    "type": "string",
                    "description": "Optional pre-compiled HTML. If omitted, Plexo automatically compiles designJson to HTML."
                  },
                  "domain": {
                    "type": "string",
                    "description": "Subdomain slug (e.g. 'acme') or full custom domain ('acme.com')",
                    "example": "acme-crm"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["SUBDOMAIN", "CUSTOM"],
                    "description": "Type of domain routing"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created and published page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "templateId": { "type": "string" },
                    "name": { "type": "string" },
                    "domain": { "type": "string" },
                    "publishedUrl": { "type": "string" },
                    "editableUrl": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized - Invalid API key" },
          "403": { "description": "Subscription limit reached" }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "summary": "Get User Profile & Usage Limits",
        "description": "Retrieves user details, subscription plan (FREE, PRO, ULTRA), AI credit balance, and domain limits.",
        "operationId": "getUserProfile",
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "User profile and active plan limits"
          }
        }
      }
    },
    "/api/v1/analytics": {
      "get": {
        "summary": "Get Visitor Analytics",
        "description": "Returns total page views, unique visitor counts, and daily timeline metrics for published landing pages.",
        "operationId": "getAnalytics",
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "templateId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Optional template ID to filter analytics"
          }
        ],
        "responses": {
          "200": { "description": "Analytics metrics" }
        }
      }
    },
    "/api/v1/sites/{id}/brand": {
      "get": {
        "summary": "Get a site's brand",
        "description": "The brand this site uses now and its Strata link. `resolved` has colours with roles, fonts, radius and logo; precedence is the linked Strata project, then the site's own saved brand, then the account's onboarding brand. Same data as the MCP tool get_site_brand.",
        "operationId": "getSiteBrand",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The site (its home page id)."
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Link state (linked, projectId, projectName, autoSync, status, lastResult) plus `resolved`."
          }
        }
      },
      "post": {
        "summary": "Link a Strata project, or create one from the site's brand",
        "description": "Body `{ projectId, projectName?, autoSync? }` links the site to one of the owner's Strata projects (auto-sync on by default). Body `{ createProject: true, name?, autoSync? }` makes a new Strata project from the site's current brand and links it. Same as the MCP tools link_site_brand and create_strata_project_from_brand.",
        "operationId": "linkSiteBrand",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The site (its home page id)."
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string"
                  },
                  "projectName": {
                    "type": "string"
                  },
                  "createProject": {
                    "type": "boolean"
                  },
                  "name": {
                    "type": "string"
                  },
                  "autoSync": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new link state plus `resolved`."
          }
        }
      },
      "patch": {
        "summary": "Brand switches",
        "description": "`{ autoSync?, useOnSite?, applyBrand?, syncNow? }`.",
        "operationId": "updateSiteBrand",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The site (its home page id)."
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The new link state plus `resolved`."
          }
        }
      },
      "delete": {
        "summary": "Stop using the linked brand",
        "operationId": "unlinkSiteBrand",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The site (its home page id)."
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The new link state."
          }
        }
      }
    },
    "/api/v1/strata/projects": {
      "get": {
        "summary": "List the owner's Strata projects",
        "description": "Needs the owner to have connected Strata. Same as the MCP tool list_strata_projects.",
        "operationId": "listStrataProjects",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ projects: [{ id, name, color, logo, role }] }"
          },
          "401": {
            "description": "Not signed in, or the Strata session ran out (kind: expired)."
          }
        }
      }
    },
    "/api/templates": {
      "get": {
        "summary": "List User Templates & Pages",
        "description": "Fetches all saved landing pages and email templates owned by the user.",
        "operationId": "listTemplates",
        "security": [
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "responses": {
          "200": { "description": "List of templates" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
